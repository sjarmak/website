---
// No-flash theme bootstrap. Must run inline in <head> before first paint.
---

<script is:inline>
  (function () {
    try {
      var key = "theme";
      var saved = localStorage.getItem(key);
      // Default to light; only honor an explicit saved preference.
      document.documentElement.dataset.theme = saved === "dark" ? "dark" : "light";
    } catch (e) {
      document.documentElement.dataset.theme = "light";
    }
  })();
</script>
