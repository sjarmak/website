---
import type { BookReference, BookReferenceCounts } from "@/lib/books/bookGraph.mjs";

interface Props {
  references: BookReference[];
  counts: BookReferenceCounts;
}

const { references, counts } = Astro.props;
const groups = [
  { kind: "paper", label: "Papers" },
  { kind: "article", label: "Articles and reports" },
  { kind: "discussion", label: "Discussions" },
  { kind: "repository", label: "Repositories" },
] as const;
---

<div class="reference-index" data-book-reference-index hidden>
  <header class="reference-index__head">
    <h2>References</h2>
    <p aria-label="Reference coverage">
      <span>{counts.references} references</span>
      <span>{counts.papers} papers</span>
      <span>{counts.articles} articles</span>
      <span>{counts.discussions} discussions</span>
      <span>{counts.repositories} repository</span>
    </p>
  </header>

  {
    groups.map((group) => {
      const entries = references.filter((reference) => reference.kind === group.kind);
      return (
        <section class="reference-group" data-reference-group={group.kind}>
          <header>
            <h3>{group.label}</h3>
            <p>{entries.length}</p>
          </header>
          <ol>
            {entries.map((reference) => {
              const parts = [...new Set(reference.citedBy.map((location) => location.part).filter(Boolean))];
              const searchText = [
                reference.citation,
                reference.identifier,
                ...reference.citedBy.map((location) => location.label),
              ].join(" ").toLowerCase();
              return (
                <li
                  class="reference-row"
                  data-book-reference={reference.id}
                  data-reference-kind={reference.kind}
                  data-parts={parts.join(",")}
                  data-search-text={searchText}
                >
                  <p class="reference-row__identifier">{reference.identifier}</p>
                  <p class="reference-row__citation">
                    <a href={reference.url} rel="noopener">{reference.citation}</a>
                  </p>
                  <details class="reference-row__locations">
                    <summary>
                      Cited in {reference.citedBy.length} {reference.citedBy.length === 1 ? "location" : "locations"}
                    </summary>
                    <ul role="list">
                      {reference.citedBy.map((location) => (
                        <li data-reference-location={location.sourceId}>
                          <a href={location.href}>{location.label}</a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })
  }

  <p class="reference-index__empty" data-reference-empty hidden>No matching references.</p>
</div>

<style>
  .reference-index {
    border-top: var(--border-hairline);
  }

  .reference-index__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    justify-content: space-between;
    align-items: baseline;
    padding-block: var(--space-l);
  }

  .reference-index__head h2 {
    font-size: var(--step-2);
  }

  .reference-index__head p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .reference-index__head span + span::before {
    margin-inline-end: var(--space-m);
    color: var(--color-border);
    content: "·";
  }

  .reference-group {
    padding-block: var(--space-l);
    border-top: var(--border-hairline);
  }

  .reference-group > header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-m);
    align-items: baseline;
  }

  .reference-group > header h3 {
    font-size: var(--step-1);
  }

  .reference-group > header p {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .reference-group ol {
    margin-block-start: var(--space-m);
    padding: 0;
    border-bottom: var(--border-hairline);
    list-style: none;
  }

  .reference-row {
    display: grid;
    grid-template-columns: minmax(9rem, 0.22fr) minmax(0, 1fr) minmax(10rem, 0.28fr);
    gap: var(--space-m) var(--space-l);
    padding-block: var(--space-m);
    border-top: var(--border-hairline);
  }

  .reference-row__identifier {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  .reference-row__citation {
    max-width: 72ch;
    font-size: var(--step--1);
    line-height: var(--leading-normal);
  }

  .reference-row__citation a {
    color: var(--color-text);
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.18em;
  }

  .reference-row__citation a:hover {
    color: var(--color-accent);
  }

  .reference-row__locations {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .reference-row__locations summary {
    min-height: 2rem;
    cursor: pointer;
  }

  .reference-row__locations ul {
    margin-block-start: var(--space-xs);
    padding: 0;
  }

  .reference-row__locations li + li {
    margin-block-start: var(--space-2xs);
  }

  .reference-row__locations a {
    color: var(--color-text-secondary);
  }

  .reference-index__empty {
    padding-block: var(--space-xl);
    border-top: var(--border-hairline);
    color: var(--color-text-muted);
  }

  @media (max-width: 52rem) {
    .reference-row {
      grid-template-columns: minmax(8rem, 0.28fr) minmax(0, 1fr);
    }

    .reference-row__locations {
      grid-column: 2;
    }
  }

  @media (max-width: 36rem) {
    .reference-row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .reference-row__locations {
      grid-column: 1;
    }

    .reference-index__head span + span::before {
      display: none;
    }
  }
</style>
