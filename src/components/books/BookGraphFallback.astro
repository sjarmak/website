---
interface GraphNode {
  id: string;
  kind: "book" | "part" | "chapter" | "practice";
  label: string;
  summary: string;
  href: string;
  part?: number;
  chapter?: number;
  classification?: "taught" | "untaught";
}

interface Props {
  nodes: GraphNode[];
  parts: { number: number; title: string }[];
}

const { nodes, parts } = Astro.props;
const chapters = nodes.filter((node) => node.kind === "chapter");
const practices = nodes.filter((node) => node.kind === "practice");
---

<div class="book-graph-list" data-book-graph-list>
  {
    parts.map((part) => (
      <section class="book-graph-part" data-book-graph-part={part.number}>
        <header>
          <p>Part {part.number}</p>
          <h2>{part.title}</h2>
        </header>
        <div class="book-graph-part__chapters">
          {chapters
            .filter((chapter) => chapter.part === part.number)
            .map((chapter) => (
              <section
                class="book-graph-chapter"
                data-book-graph-chapter
                data-part={part.number}
                data-search-text={chapter.label.toLowerCase()}
              >
                <header>
                  <h3><a href={chapter.href}>{chapter.label}</a></h3>
                  <p>{chapter.summary}</p>
                </header>
                <div class="book-graph-chapter__groups">
                  {(["taught", "untaught"] as const).map((classification) => {
                    const matches = practices.filter(
                      (practice) =>
                        practice.chapter === chapter.chapter &&
                        practice.classification === classification,
                    );
                    return (
                      <section data-practice-group={classification}>
                        <h4>{classification === "taught" ? "Taught in the chapter" : "Carried in the companion"}</h4>
                        <ul role="list">
                          {matches.map((practice) => (
                            <li
                              data-book-graph-practice
                              data-classification={classification}
                              data-part={part.number}
                              data-search-text={`${practice.label} ${practice.summary}`.toLowerCase()}
                            >
                              <a href={practice.href}>{practice.label}</a>
                            </li>
                          ))}
                        </ul>
                      </section>
                    );
                  })}
                </div>
              </section>
            ))}
        </div>
      </section>
    ))
  }
  <p class="book-graph-list__empty" data-book-graph-empty hidden>No matching practices.</p>
</div>

<style>
  .book-graph-list {
    border-top: var(--border-hairline);
  }

  .book-graph-part {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-xl);
    border-bottom: var(--border-hairline);
  }

  .book-graph-part > header p {
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }

  .book-graph-part > header h2 {
    margin-block-start: var(--space-2xs);
    font-size: var(--step-1);
  }

  .book-graph-chapter {
    padding-block: var(--space-m);
  }

  .book-graph-chapter:first-child {
    padding-block-start: 0;
  }

  .book-graph-chapter + .book-graph-chapter {
    border-top: var(--border-hairline);
  }

  .book-graph-chapter > header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    justify-content: space-between;
    align-items: baseline;
  }

  .book-graph-chapter h3 {
    max-width: 40rem;
    font-size: var(--step-0);
  }

  .book-graph-chapter > header p,
  .book-graph-chapter h4 {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .book-graph-chapter__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l);
    margin-block-start: var(--space-m);
  }

  .book-graph-chapter h4 {
    margin-block-end: var(--space-xs);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
  }

  .book-graph-chapter ul {
    padding: 0;
  }

  .book-graph-chapter li + li {
    margin-block-start: var(--space-xs);
  }

  .book-graph-chapter li {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }

  .book-graph-list__empty {
    padding-block: var(--space-xl);
    color: var(--color-text-muted);
  }

  @media (max-width: 48rem) {
    .book-graph-part {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .book-graph-chapter__groups {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
