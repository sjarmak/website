        <rect class="svg-box svg-box--accent" x="30" y="316" width="300" height="96" rx="10" />
        <text class="svg-label" x="52" y="346">task 41 · host w3</text>
        <text class="svg-small" x="52" y="370">base 4f19c · changes Session()</text>
