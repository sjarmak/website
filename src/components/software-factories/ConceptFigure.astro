{
  kind === "promises" && (
    <figure class="concept-figure" aria-labelledby={titleId}>
      <header class="concept-figure__header">
        <p class="concept-figure__index">Figure 09 / Observability</p>
        <h3 id={titleId}>The promise chain, and where silence means failure</h3>
      </header>

      <svg
        class="concept-figure__svg"
        viewBox="0 0 1100 420"
        role="img"
        aria-labelledby={`${svgTitleId} ${svgDescId}`}
      >
        <title id={svgTitleId}>States and transition budgets from ready to settled</title>
        <desc id={svgDescId}>
          Work moves from ready through claimed, running, completed, verified,
          and published to settled. Each transition carries a latency budget,
          and the alert condition is a state entered and not left.
        </desc>

        <rect class="svg-box svg-box--durable" x="10" y="150" width="130" height="60" rx="9" />
        <rect class="svg-durable-inner" x="16" y="156" width="118" height="48" rx="5" />
        <text class="svg-small" x="36" y="186">ready</text>

        <path class="svg-link svg-link--dashed svg-link--flow" d="M140 180 H190" />
        <rect class="svg-box" x="190" y="150" width="130" height="60" rx="9" />
        <text class="svg-small" x="212" y="186">claimed</text>

        <path class="svg-link svg-link--dashed svg-link--flow" d="M320 180 H370" />
        <rect class="svg-box svg-box--stale" x="370" y="150" width="130" height="60" rx="9" />
        <text class="svg-small" x="392" y="186">running</text>
        <path class="svg-hourglass" d="M-7 -10 H7 L-7 10 H7 Z" transform="translate(435 118)" />
        <text class="svg-small" x="356" y="92">entered, never left</text>
        <text class="svg-small" x="356" y="72">no error emitted</text>

        <path class="svg-link svg-link--broken" d="M500 180 H518 M532 180 H550" />
        <rect class="svg-box" x="550" y="150" width="140" height="60" rx="9" />
        <text class="svg-small" x="572" y="186">completed</text>

        <path class="svg-link svg-link--dashed svg-link--flow" d="M690 180 H740" />
        <rect class="svg-box" x="740" y="150" width="130" height="60" rx="9" />
        <text class="svg-small" x="762" y="186">verified</text>

        <path class="svg-link svg-link--dashed svg-link--flow" d="M870 180 H920" />
        <rect class="svg-box svg-box--accent" x="920" y="150" width="160" height="60" rx="9" />
        <text class="svg-small" x="942" y="186">published</text>

        <path class="svg-link svg-link--dashed svg-link--flow" d="M1000 210 V262 H700" />
        <rect class="svg-box svg-box--durable" x="560" y="262" width="140" height="60" rx="9" />
        <rect class="svg-durable-inner" x="566" y="268" width="128" height="48" rx="5" />
        <text class="svg-small" x="586" y="298">settled</text>
        <path class="svg-ack" d="M-8 0 L-2 6 L8 -7" transform="translate(676 284)" />

        <text class="svg-eyebrow" x="20" y="252">every transition is a latency with a budget</text>

        <rect class="svg-box" x="20" y="330" width="360" height="66" rx="9" />
        <text class="svg-small" x="42" y="360">blocked work promises visibility</text>
        <text class="svg-small" x="42" y="382">rather than disappearing into a queue</text>

        <rect class="svg-box" x="410" y="330" width="360" height="66" rx="9" />
        <text class="svg-small" x="432" y="360">recovery promises a drain rate</text>
        <text class="svg-small" x="432" y="382">bounded after the dependency returns</text>

        <text class="svg-eyebrow" x="800" y="360">a thousand healthy</text>
        <text class="svg-eyebrow" x="800" y="382">processes, a dead factory</text>
      </svg>

      <ul class="concept-figure__fallback" aria-label="Figure summary">
        <li>Work promises to move from ready through claimed, running, completed, verified, and published to settled.</li>
        <li>Each transition is a latency with a budget, so the alert condition is a state entered and not left.</li>
        <li>Blocked work promises to become visible; recovery promises to drain within a bounded period.</li>
        <li>Activity metrics can look healthy through all of it, because a stopped loop and an idle loop emit the same silence.</li>
      </ul>

      <figcaption class="figure-caption">
        The useful signal is usually not a component reporting an error. It is
        a state that was entered and never left.
      </figcaption>
    </figure>
  )
}

<style>
  .concept-figure {
    --figure-rule: color-mix(in srgb, var(--color-text) 22%, transparent);
    width: 100%;
    max-width: 68rem;
    min-width: 0;
    margin: clamp(var(--space-xl), 7vw, var(--space-3xl)) auto;
    color: var(--color-text);
  }

  /* Single column, index stacked above the title. The writing route hides
     `.concept-figure__index` (figure numbers only make sense in the long-form
     article), and a two-column header would leave the title stranded in a
     narrow first column once that happens. */
  .concept-figure__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block-end: var(--space-s);
    gap: var(--space-2xs);
    border-block-end: 1px solid var(--figure-rule);
  }

  .concept-figure__header p,
  .concept-figure__header h3 {
    margin: 0;
  }

  .concept-figure__header h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-tight);
  }

  .concept-figure__index {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .concept-figure__svg {
    display: block;
    width: 100%;
    height: auto;
    margin-block-start: var(--space-m);
    color: var(--color-text);
  }

  .concept-figure__svg :global(path),
  .concept-figure__svg :global(rect),
  .concept-figure__svg :global(circle) {
    vector-effect: non-scaling-stroke;
  }

  .svg-box {
    fill: var(--color-bg-subtle);
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .svg-box--accent {
    fill: color-mix(in srgb, var(--color-accent) 9%, var(--color-bg));
    stroke: var(--color-accent);
  }

  /* A superseded or stale element: still present, no longer authoritative. */
  .svg-box--stale {
    fill: color-mix(in srgb, var(--color-bg-subtle) 55%, transparent);
    stroke: color-mix(in srgb, currentColor 45%, transparent);
    stroke-dasharray: 6 5;
  }

  .svg-box--durable {
    stroke-width: 1.5;
  }

  .svg-durable-inner {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .svg-lane {
    fill: color-mix(in srgb, var(--color-text) 4%, transparent);
    stroke: none;
  }

  .svg-link {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .svg-link--dashed {
    stroke: var(--color-accent);
    stroke-dasharray: 7 6;
  }

  .svg-link--broken {
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .svg-link--flow {
    animation: svg-flow-dash 2.4s linear infinite;
  }

  @keyframes svg-flow-dash {
    to {
      stroke-dashoffset: -26;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svg-link--flow {
      animation: none;
    }
  }

  .svg-arrow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .svg-bolt {
    fill: var(--color-accent);
    stroke: var(--color-bg);
    stroke-width: 1;
  }

  .svg-hourglass {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .svg-fence {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linejoin: round;
  }

  .svg-ack {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .svg-eyebrow,
  .svg-small,
  .svg-cross {
    fill: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .svg-eyebrow {
    fill: var(--color-text-secondary);
    font-size: 13px;
  }

  .svg-cross {
    fill: var(--color-accent);
  }

  .svg-label {
    fill: currentColor;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
  }

  .svg-label--center {
    text-anchor: middle;
  }

  .figure-caption {
    max-width: var(--measure);
    margin-block-start: var(--space-s);
    margin-inline: auto;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: 1.4;
    text-align: center;
  }

  .concept-figure__fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 720px) {
    .concept-figure__header {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    /* The whole diagram is shown, fitted, rather than cropped to a scrolling
       strip: a diagram cut off at the viewport edge reads as broken. Its
       labels are too small to study at this size, so the script adds an
       enlarge control and the bullet summary carries the same content. */
    .concept-figure__svg {
      min-width: 0;
    }

    .concept-figure__fallback {
      position: static;
      display: grid;
      width: auto;
      height: auto;
      margin: var(--space-m) 0 0;
      padding-inline-start: 1.25rem;
      overflow: visible;
      clip: auto;
      gap: var(--space-xs);
      white-space: normal;
      color: var(--color-text-secondary);
      font-size: var(--step--1);
    }
  }

  :global(.concept-figure__enlarge) {
    display: none;
  }

  @media (max-width: 720px) {
    :global(.concept-figure__enlarge) {
      display: inline-block;
      margin-block-start: var(--space-s);
      padding: var(--space-2xs) var(--space-s);
      border: var(--border-hairline);
      border-radius: var(--radius);
      background: var(--color-bg-subtle);
      color: var(--color-text);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      cursor: pointer;
    }
  }

  :global(.figure-zoom) {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }

  :global(.figure-zoom::backdrop) {
    background: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  :global(.figure-zoom__bar) {
    display: flex;
    padding: var(--space-xs) var(--space-s);
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    border-block-end: var(--border-hairline);
  }

  :global(.figure-zoom__title) {
    font-family: var(--font-display);
    font-size: var(--step-0);
  }

  :global(.figure-zoom__close) {
    padding: var(--space-2xs) var(--space-s);
    border: var(--border-hairline);
    border-radius: var(--radius);
    background: var(--color-bg-subtle);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
  }

  /* The viewer is the one place panning is right: the reader opted into
     reading the diagram, so the frame is explicitly a scrollable stage. */
  :global(.figure-zoom__stage) {
    display: grid;
    height: calc(100dvh - 3.5rem);
    padding: var(--space-s);
    align-content: center;
    justify-content: start;
    overflow: auto;
    overscroll-behavior: contain;
  }

  :global(.figure-zoom__stage svg.concept-figure__svg) {
    width: 52rem;
    max-width: none;
    height: auto;
    margin-block-start: 0;
  }
</style>

<script>
  // Phone-width diagrams are fitted, which makes their labels too small to
  // study. This adds an explicit way to read one: the same SVG, at a size its
  // type survives, inside a stage the reader can pan. One dialog is shared by
  // every figure on the page.
  const figures = document.querySelectorAll(".concept-figure");

  if (figures.length > 0) {
    const dialog = document.createElement("dialog");
    dialog.className = "figure-zoom";
    dialog.innerHTML = `
      <div class="figure-zoom__bar">
        <span class="figure-zoom__title"></span>
        <button type="button" class="figure-zoom__close">Close</button>
      </div>
      <div class="figure-zoom__stage"></div>`;
    document.body.append(dialog);

    const title = dialog.querySelector(".figure-zoom__title");
    const stage = dialog.querySelector(".figure-zoom__stage");
    dialog
      .querySelector(".figure-zoom__close")
      ?.addEventListener("click", () => dialog.close());

    for (const figure of figures) {
      const svg = figure.querySelector("svg");
      const heading = figure.querySelector("h3");
      if (!svg || !heading) continue;

      const button = document.createElement("button");
      button.type = "button";
      button.className = "concept-figure__enlarge";
      button.textContent = "Enlarge diagram";
      button.setAttribute("aria-label", `Enlarge diagram: ${heading.textContent?.trim()}`);
      svg.after(button);

      button.addEventListener("click", () => {
        if (title) title.textContent = heading.textContent?.trim() ?? "";
        stage?.replaceChildren(svg.cloneNode(true));
        dialog.showModal();
        if (stage) stage.scrollLeft = 0;
      });
    }
  }
</script>
