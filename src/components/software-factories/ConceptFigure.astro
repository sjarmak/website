        <text class="svg-label" x="772" y="346">task 52 · stale base</text>
        <text class="svg-small" x="772" y="370">planned against 4f19c,</text>
        <text class="svg-small" x="772" y="392">which has since moved</text>

        <path class="svg-link svg-link--broken" d="M330 364 H355 M365 364 H390" />
