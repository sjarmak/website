---
/**
 * "Related" block (PRD R5): links to concept pages plus essays/talks/projects
 * that share ≥1 derived concept. All inputs are build-time derived by
 * src/lib/knowledge/relatedContent — this component only renders.
 *
 * Renders NOTHING when there is no real edge (empty concepts AND items), so
 * callers can pass derived data unconditionally without producing empty blocks.
 */
import { conceptLabel, type RelatedDoc } from "@/lib/knowledge/relatedContent";

interface Props {
  /** Resolved concept slugs (link to /concepts/<slug>/). */
  concepts: string[];
  /** Related content docs sharing concepts with this page. */
  items?: RelatedDoc[];
  /** Compact single-line variant for index entries (concepts only). */
  compact?: boolean;
}

const { concepts, items = [], compact = false } = Astro.props;

const KIND_LABEL: Record<RelatedDoc["kind"], string> = {
  essay: "essay",
  talk: "talk",
  project: "project",
};
---

{
  compact
    ? concepts.length > 0 && (
        <p class="related-block related-block--line muted">
          Concepts:{" "}
          {concepts.map((slug, i) => (
            <>
              {i > 0 && ", "}
              <a class="related-block__concept-link" href={`/concepts/${slug}/`}>
                {conceptLabel(slug)}
              </a>
            </>
          ))}
        </p>
      )
    : (concepts.length > 0 || items.length > 0) && (
        <aside class="related-block" aria-label="Related content">
          <h2 class="related-block__heading">Related</h2>
          {concepts.length > 0 && (
            <ul role="list" class="cluster" style="--cluster-gap: var(--space-2xs)">
              {concepts.map((slug) => (
                <li>
                  <a class="tag related-block__concept" href={`/concepts/${slug}/`}>
                    {conceptLabel(slug)}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {items.length > 0 && (
            <ul role="list" class="related-block__items stack stack-s">
              {items.map((item) => (
                <li>
                  <a href={item.url}>{item.title}</a>
                  <span class="related-block__kind muted"> · {KIND_LABEL[item.kind]}</span>
                </li>
              ))}
            </ul>
          )}
        </aside>
      )
}

<style>
  aside.related-block {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-m);
    border-top: var(--border-hairline);
    display: grid;
    gap: var(--space-s);
  }
  .related-block__heading {
    font-size: var(--step-1);
  }
  a.related-block__concept {
    text-decoration: none;
  }
  a.related-block__concept:hover {
    color: var(--color-accent);
  }
  .related-block__items a {
    color: var(--color-text);
    text-decoration: none;
  }
  .related-block__items a:hover {
    color: var(--color-accent);
  }
  .related-block__kind {
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }
  .related-block--line {
    font-size: var(--step--1);
  }
  .related-block--line a {
    color: var(--color-text-secondary);
  }
  .related-block--line a:hover {
    color: var(--color-accent);
  }
</style>
