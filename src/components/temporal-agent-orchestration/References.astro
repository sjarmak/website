// the two read as a pair at the foot of the page: collapsed by default, opened
// by a reader who wants the trail rather than the argument. Each entry says
// where it is used, because a bare URL list makes the reader re-find the
// sentence it belonged to.

interface Entry {
  title: string;
  href: string;
  source: string;
  note: string;
}

interface Group {
  title: string;
  intro: string;
  entries: Entry[];
}

