---

<section class="references" aria-labelledby="references-title">
  <header class="references__head">
    <h2 id="references-title">References</h2>
    <p>
      Everything this page cites, grouped by what it is. Open the group you
      need.
    </p>
  </header>
  {
    groups.map((group) => (
      <details class="references__group">
        <summary>
          <span>{group.title}</span>
          <span class="references__group-intro">{group.intro}</span>
        </summary>
        <ul>
          {group.entries.map((entry) => (
            <li class="references__entry">
              {/* On-site entries stay in the tab; only outbound links open a new one. */}
              <a
                href={entry.href}
                rel={entry.href.startsWith("http") ? "noopener noreferrer" : undefined}
                target={entry.href.startsWith("http") ? "_blank" : undefined}
              >
                {entry.title}
              </a>
              <span class="references__source">{entry.source}</span>
              <p class="references__note">{entry.note}</p>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</section>

<style>
  .references {
    display: grid;
    gap: var(--space-s);
  }

  .references__head {
    max-width: var(--measure);
  }

  .references__head h2 {
    margin: 0;
  }

  .references__head p {
    margin: var(--space-s) 0 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .references__group {
    border-block: var(--border-hairline);
  }

  .references__group + .references__group {
    border-block-start: 0;
  }

  .references__group summary {
    display: flex;
    padding-block: var(--space-s);
    align-items: baseline;
    gap: var(--space-s);
    flex-wrap: wrap;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--step-1);
    cursor: pointer;
  }

  .references__group summary:hover {
    color: var(--color-accent);
  }

  .references__group-intro {
    color: var(--color-text-muted);
    font-family: var(--font-body, inherit);
    font-size: var(--step--1);
  }

  .references__group ul {
    margin: 0;
    padding: var(--space-xs) 0 var(--space-m);
    list-style: none;
  }

  .references__entry {
    max-width: 60rem;
    padding-block: var(--space-2xs);
  }

  .references__entry + .references__entry {
    margin-block-start: var(--space-s);
  }

  .references__entry a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  .references__source {
    display: block;
    margin-block-start: var(--space-3xs, 0.15rem);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .references__note {
    margin: var(--space-2xs) 0 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
