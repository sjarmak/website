  }

  .concept-figure__header p,
  .concept-figure__header h3 {
    margin: 0;
  }

  .concept-figure__header h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-tight);
  }

  .concept-figure__index {
