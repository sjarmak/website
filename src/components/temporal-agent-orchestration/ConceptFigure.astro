  .svg-box {
    fill: var(--color-bg-subtle);
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .svg-box--accent {
    fill: color-mix(in srgb, var(--color-accent) 9%, var(--color-bg));
    stroke: var(--color-accent);
  }

  .svg-link {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .svg-link--dashed {
    stroke: var(--color-accent);
    stroke-dasharray: 7 6;
  }

  /* Visual grammar: one legend across every diagram. A durable record wears a
     double outline, a crash window is a bolt on the edge it interrupts, a
     failed integration contract is a broken edge between systems (the
     components stay healthy), shadow mode is a translucent barrier. */
  .svg-box--durable {
    stroke-width: 1.5;
  }

  .svg-durable-inner {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .svg-box--muted {
