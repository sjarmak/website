    stroke: color-mix(in srgb, currentColor 40%, transparent);
  }

  .svg-lane {
    fill: color-mix(in srgb, var(--color-text) 4%, transparent);
    stroke: none;
  }

  .svg-bolt {
    fill: var(--color-accent);
    stroke: var(--color-bg);
    stroke-width: 1;
  }

  .svg-barrier {
    fill: color-mix(in srgb, var(--color-text) 7%, transparent);
    stroke: color-mix(in srgb, var(--color-text) 35%, transparent);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }

  .svg-hourglass {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .svg-fence {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linejoin: round;
  }

  .svg-link--broken {
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .svg-ack {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .svg-link--flow {
