  }

  .concept-figure__svg {
    display: block;
    width: 100%;
    height: auto;
    margin-block-start: var(--space-m);
    color: var(--color-text);
  }

  .concept-figure__svg :global(path),
  .concept-figure__svg :global(rect),
  .concept-figure__svg :global(circle) {
    vector-effect: non-scaling-stroke;
  }

  .svg-box {
    fill: var(--color-bg-subtle);
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .svg-box--accent {
    fill: color-mix(in srgb, var(--color-accent) 9%, var(--color-bg));
    stroke: var(--color-accent);
  }

  .svg-link {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .svg-link--dashed {
    stroke: var(--color-accent);
    stroke-dasharray: 7 6;
  }

  /* Visual grammar: one legend across every diagram. A durable record wears a
     double outline, a crash window is a bolt on the edge it interrupts, a
     failed integration contract is a broken edge between systems (the
     components stay healthy), shadow mode is a translucent barrier.

     Edges: a solid link is a structural connection; a dashed accent link is a
     message crossing a boundary. When that message's motion is repeatable
     (delivery, redelivery, retry, an at-least-once attempt) the edge also
     carries --flow, and its path MUST be drawn in the direction of travel,
     because the dash animation marches from path start to path end. A dashed
     edge without --flow is inspection or reconstruction the reader should see
     as a relationship, not traffic. The acknowledgement check sits inside the
     box it seals, clear of the border. */
  .svg-box--durable {
    stroke-width: 1.5;
  }

  .svg-durable-inner {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .svg-box--muted {
    fill: color-mix(in srgb, var(--color-bg-subtle) 55%, transparent);
    stroke: color-mix(in srgb, currentColor 40%, transparent);
  }

  .svg-lane {
    fill: color-mix(in srgb, var(--color-text) 4%, transparent);
    stroke: none;
  }

  .svg-bolt {
    fill: var(--color-accent);
    stroke: var(--color-bg);
    stroke-width: 1;
  }

  .svg-barrier {
    fill: color-mix(in srgb, var(--color-text) 7%, transparent);
    stroke: color-mix(in srgb, var(--color-text) 35%, transparent);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }

  .svg-hourglass {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .svg-fence {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linejoin: round;
  }

  .svg-link--broken {
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .svg-ack {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .svg-link--flow {
    animation: svg-flow-dash 2.4s linear infinite;
  }

  @keyframes svg-flow-dash {
    to {
      stroke-dashoffset: -26;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svg-link--flow {
      animation: none;
    }
  }

  .svg-eyebrow,
  .svg-small {
    fill: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .svg-eyebrow {
