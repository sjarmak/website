---
import { readFileSync } from "node:fs";
import path from "node:path";
import { codeToHtml } from "shiki";

import {
  preTemporalAgentOrchestrationCodeSamples,
  temporalAgentOrchestrationCodeSamples,
  validateTemporalAgentOrchestrationCodeSamples,
} from "@/data/temporal-agent-orchestration-code-samples";

interface Props {
  mode?: "before" | "after";
}

const { mode = "after" } = Astro.props;
const isBefore = mode === "before";
const codeSamples = isBefore
  ? preTemporalAgentOrchestrationCodeSamples
  : temporalAgentOrchestrationCodeSamples;
const readerId = `annotated-code-${mode}`;

const preparedSamples = await Promise.all(
  codeSamples.map(async (sample) => {
    const source = readFileSync(path.join(process.cwd(), sample.sourcePath), "utf8")
      .replace(/\n$/, "");
    const lines = source.split("\n");
    return {
      ...sample,
      lineCount: lines.length,
      sections: await Promise.all(
        sample.sections.map(async (section) => ({
          ...section,
          html: await codeToHtml(
            lines.slice(section.start - 1, section.end).join("\n"),
            {
              lang: "go",
              themes: {
                light: "one-light",
                dark: "one-dark-pro",
              },
            },
          ),
        })),
      ),
    };
  }),
);

validateTemporalAgentOrchestrationCodeSamples(
  codeSamples,
  Object.fromEntries(
    preparedSamples.map((sample) => [sample.filename, sample.lineCount]),
  ),
);
---

<section class="annotated-code" aria-labelledby={`${readerId}-title`}>
  <header class="annotated-code__header">
    <div>
      <p class="annotated-code__kicker">
        {isBefore ? "Before Temporal" : "After Temporal"}
      </p>
      <h2 id={`${readerId}-title`}>
        {
          isBefore
            ? "The procedure was split across controller and repair code"
            : "Read the new boundary in the code"
        }
      </h2>
    </div>
    <p>
      {
        isBefore
          ? "These selected excerpts are abridged for reading and linked to the complete source at the exact pre-Temporal revision."
          : "Each file opens as a short preview. Show the full file, then select any line section to open its explanation beside the code window."
      }
    </p>
  </header>

  {
    isBefore && (
      <p class="annotated-code__provenance">
        <strong>Versioned before code.</strong> Both excerpts come from Gas City
        revision <code>b78058917</code>, before the Temporal service was added.
        The source links open the original files and line ranges.
      </p>
    )
  }
  {
    !isBefore && (
      <p class="annotated-code__provenance">
        <strong>Versioned implementation code.</strong> Each file names the exact
        reviewed revision it came from. Source review and production activation
        have separate evidence; the status under each filename records what the
        corresponding live canary actually proved.
      </p>
    )
  }

  <div
    class="annotated-code__tabs"
    role="tablist"
    aria-label={`${isBefore ? "Pre-Temporal" : "Temporal"} Go source files`}
    style={`--tab-count: ${preparedSamples.length}`}
  >
    {
      preparedSamples.map((sample, index) => (
        <button
          id={`${readerId}-tab-${sample.slug}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`${readerId}-panel-${sample.slug}`}
          tabindex={index === 0 ? "0" : "-1"}
          data-code-tab={sample.slug}
        >
          <span>{sample.label}</span>
          <small>{sample.filename}</small>
        </button>
      ))
    }
  </div>

  {
    preparedSamples.map((sample, sampleIndex) => (
      <section
        id={`${readerId}-panel-${sample.slug}`}
        class="annotated-code__panel"
        role="tabpanel"
        aria-labelledby={`${readerId}-tab-${sample.slug}`}
        data-code-file={sample.slug}
        data-file-expanded="false"
        hidden={sampleIndex !== 0}
      >
        <header class="annotated-code__file-header">
          <div>
            <h3>{sample.label}</h3>
            <p>{sample.summary}</p>
            {(sample.revision || sample.promotionStatus) && (
              <p class="annotated-code__status">
                {sample.revision && (
                  <>
                    <strong>Revision:</strong> <code>{sample.revision}</code>
                  </>
                )}
                {sample.promotionStatus && (
                  <>
                    {sample.revision && <br />}
                    <strong>Promotion:</strong> {sample.promotionStatus}
                  </>
                )}
              </p>
            )}
            {sample.evidenceTrail && (
              <ol
                class="annotated-code__evidence"
                aria-label="Canary evidence trail"
              >
                {sample.evidenceTrail.map((step) => (
                  <li>
                    <strong>{step.label}</strong>
                    <span>{step.detail}</span>
                    {step.revision && <code>{step.revision}</code>}
                  </li>
                ))}
              </ol>
            )}
            {sample.sourceUrl && (
              <a
                class="annotated-code__source-link"
                href={sample.sourceUrl}
                target="_blank"
                rel="noreferrer"
              >
                View original source: {sample.sourceLabel}
                <span aria-hidden="true"> ↗</span>
              </a>
            )}
          </div>
          <div class="annotated-code__file-actions">
            <button
              type="button"
              data-file-toggle
              aria-expanded="false"
              aria-controls={`${readerId}-${sample.slug}-full-source`}
            >
              <span class="annotated-code__show-label">Show full file</span>
              <span class="annotated-code__hide-label">Collapse file</span>
              <span aria-hidden="true">↕</span>
            </button>
            <a href={sample.rawPath} download={sample.filename}>
              Download {sample.filename} <span aria-hidden="true">↓</span>
            </a>
          </div>
        </header>

        <div class="annotated-code__stage" data-inspector-open="false">
          <div class="annotated-code__code-window">
            <div
              id={`${readerId}-${sample.slug}-full-source`}
              class="annotated-code__file-frame"
            >
              <div class="annotated-code__file">
                {sample.sections.map((section) => (
                  <section
                    class="annotated-code__segment"
                    data-code-section={section.start}
                    data-expanded="false"
                  >
                    <div
                      class="annotated-code__source-trigger"
                      role="button"
                      tabindex="0"
                      aria-expanded="false"
                      aria-controls={`${readerId}-${sample.slug}-explanation-${section.start}`}
                      aria-label={`Lines ${section.start} through ${section.end}: ${section.title}. Toggle explanation.`}
                    >
                      <div
                        class="annotated-code__source"
                        style={`--start-line: ${section.start}`}
                        set:html={section.html}
                      />
                      <span
                        class="annotated-code__section-cue"
                        aria-hidden="true"
                      >
                        <span>Lines {section.start}–{section.end}</span>
                        <span class="annotated-code__cue-action">
                          <span class="annotated-code__cue-open">Explain</span>
                          <span class="annotated-code__cue-close">Close</span>
                          <span class="annotated-code__chevron">›</span>
                        </span>
                      </span>
                    </div>
                  </section>
                ))}
              </div>
              <div
                class="annotated-code__preview-fade"
                aria-hidden="true"
              ></div>
            </div>

            <button
              class="annotated-code__collapse"
              type="button"
              data-file-toggle
              aria-expanded="false"
              aria-controls={`${readerId}-${sample.slug}-full-source`}
            >
              Collapse file <span aria-hidden="true">↑</span>
            </button>
          </div>

          <aside
            class="annotated-code__inspector"
            data-code-inspector
            aria-label={`Explanation for ${sample.label}`}
            hidden
          >
            {sample.sections.map((section) => (
              <article
                class="annotated-code__explanation"
                id={`${readerId}-${sample.slug}-explanation-${section.start}`}
                data-code-explanation={section.start}
                role="region"
                aria-labelledby={`${readerId}-${sample.slug}-section-${section.start}`}
                hidden
              >
                <header>
                  <div>
                    <p class="annotated-code__line-range">
                      Lines {section.start}–{section.end}
                    </p>
                    <h3 id={`${readerId}-${sample.slug}-section-${section.start}`}>
                      {section.title}
                    </h3>
                  </div>
                  <button type="button" data-inspector-close>
                    Close <span aria-hidden="true">×</span>
                  </button>
                </header>
                <div class="annotated-code__explanation-body">
                  <dl>
                    <div>
                      <dt>What this section does</dt>
                      <dd>{section.purpose}</dd>
                    </div>
                    <div>
                      <dt>
                        {
                          isBefore
                            ? "What this boundary exposed"
                            : "Why it matters for Temporal"
                        }
                      </dt>
                      <dd>{section.whyTemporal}</dd>
                    </div>
                  </dl>
                  <ul aria-label="Section concepts">
                    {section.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </aside>
        </div>
      </section>
    ))
  }
</section>

<script>
  for (const reader of document.querySelectorAll<HTMLElement>(
    ".annotated-code",
  )) {
    const tabs = Array.from(
      reader.querySelectorAll<HTMLButtonElement>("[data-code-tab]"),
    );
    const panels = Array.from(
      reader.querySelectorAll<HTMLElement>("[data-code-file]"),
    );

    const setFileExpanded = (panel: HTMLElement, expanded: boolean) => {
      panel.dataset.fileExpanded = String(expanded);
      for (const toggle of panel.querySelectorAll<HTMLButtonElement>(
        "[data-file-toggle]",
      )) {
        toggle.setAttribute("aria-expanded", String(expanded));
      }
    };

    const selectFile = (selected: HTMLButtonElement) => {
      const slug = selected.dataset.codeTab;
      for (const tab of tabs) {
        const active = tab === selected;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.codeFile !== slug;
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectFile(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
          return;
        }
        event.preventDefault();
        const nextIndex =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : event.key === "ArrowRight"
                ? (index + 1) % tabs.length
                : (index - 1 + tabs.length) % tabs.length;
        const next = tabs[nextIndex];
        selectFile(next);
        next.focus();
      });
    });

    for (const panel of panels) {
      const stage = panel.querySelector<HTMLElement>(
        ".annotated-code__stage",
      );
      const inspector = panel.querySelector<HTMLElement>(
        "[data-code-inspector]",
      );
      const sections = Array.from(
        panel.querySelectorAll<HTMLElement>("[data-code-section]"),
      );
      const explanations = Array.from(
        panel.querySelectorAll<HTMLElement>("[data-code-explanation]"),
      );
      const setExpanded = (current: HTMLElement, expanded: boolean) => {
        const trigger = current.querySelector<HTMLElement>(
          ".annotated-code__source-trigger",
        );
        if (!trigger || !stage || !inspector) return;

        const selected = expanded
          ? explanations.find(
              (explanation) =>
                explanation.dataset.codeExplanation ===
                current.dataset.codeSection,
            )
          : undefined;
        for (const section of sections) {
          const active = section === current && expanded;
          section.dataset.expanded = String(active);
          section
            .querySelector<HTMLElement>(".annotated-code__source-trigger")
            ?.setAttribute("aria-expanded", String(active));
        }
        for (const explanation of explanations) {
          explanation.hidden = explanation !== selected;
        }
        inspector.hidden = !selected;
        stage.dataset.inspectorOpen = String(Boolean(selected));
      };

      for (const toggle of panel.querySelectorAll<HTMLButtonElement>(
        "[data-file-toggle]",
      )) {
        toggle.addEventListener("click", () => {
          const shouldExpand = panel.dataset.fileExpanded !== "true";
          setFileExpanded(panel, shouldExpand);
          if (!shouldExpand) {
            for (const section of sections) setExpanded(section, false);
            requestAnimationFrame(() => {
              panel.scrollIntoView({ block: "start" });
            });
          }
        });
      }

      for (const current of sections) {
        const trigger = current.querySelector<HTMLElement>(
          ".annotated-code__source-trigger",
        );
        if (!trigger) continue;

        const toggleCurrent = () => {
          const selection = window.getSelection();
          if (selection && !selection.isCollapsed) return;

          const shouldOpen = current.dataset.expanded !== "true";
          for (const section of sections) {
            if (section !== current) setExpanded(section, false);
          }
          setExpanded(current, shouldOpen);
        };

        trigger.addEventListener("click", toggleCurrent);
        trigger.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            toggleCurrent();
          }
        });
      }

      for (const close of panel.querySelectorAll<HTMLButtonElement>(
        "[data-inspector-close]",
      )) {
        close.addEventListener("click", () => {
          const selected = sections.find(
            (section) => section.dataset.expanded === "true",
          );
          if (selected) setExpanded(selected, false);
        });
      }
    }
  }
</script>

<style>
  .annotated-code {
    --reader-rule: color-mix(in srgb, var(--color-text) 18%, transparent);
    width: 100%;
    max-width: 78rem;
    min-width: 0;
    margin-block: clamp(var(--space-xl), 7vw, var(--space-3xl));
    margin-inline: auto;
  }

  .annotated-code__header {
    display: grid;
    grid-template-columns: minmax(15rem, 4fr) minmax(0, 7fr);
    margin-block-end: var(--space-l);
    gap: var(--space-xl);
    align-items: start;
  }

  .annotated-code__kicker {
    margin: 0 0 var(--space-xs);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .annotated-code__header h2,
  .annotated-code__header > p {
    margin: 0;
  }

  .annotated-code__header > p {
    max-width: var(--measure);
    color: var(--color-text-secondary);
    font-size: var(--step-1);
    line-height: var(--leading-relaxed);
  }

  .annotated-code__provenance {
    margin: 0 0 var(--space-m);
    padding: var(--space-s) var(--space-m);
    border-inline-start: 2px solid var(--color-accent);
    background: var(--color-bg-subtle);
    color: var(--color-text-secondary);
    font-size: var(--step--1);
  }

  .annotated-code__provenance code {
    color: var(--color-text);
    font-size: 0.92em;
  }

  .annotated-code__tabs {
    display: grid;
    grid-template-columns: repeat(var(--tab-count), minmax(0, 1fr));
    min-width: 0;
    border: 1px solid var(--reader-rule);
  }

  .annotated-code__tabs button {
    display: grid;
    min-width: 0;
    padding: var(--space-s);
    gap: 0.15rem;
    border: 0;
    border-inline-end: 1px solid var(--reader-rule);
    background: var(--color-bg);
    color: var(--color-text-secondary);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .annotated-code__tabs button:last-child {
    border-inline-end: 0;
  }

  .annotated-code__tabs button:hover,
  .annotated-code__tabs button[aria-selected="true"] {
    background: var(--color-bg-subtle);
    color: var(--color-text);
  }

  .annotated-code__tabs button[aria-selected="true"] {
    box-shadow: inset 0 -3px var(--color-accent);
  }

  .annotated-code__tabs button:focus-visible {
    z-index: 1;
    outline: 2px solid var(--color-accent);
    outline-offset: -3px;
  }

  .annotated-code__tabs span {
    overflow: hidden;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .annotated-code__tabs small {
    overflow: hidden;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .annotated-code__panel[hidden] {
    display: none;
  }

  .annotated-code__panel {
    min-width: 0;
  }

  .annotated-code__file-header {
    display: flex;
    padding-block: var(--space-m);
    align-items: end;
    justify-content: space-between;
    gap: var(--space-l);
    border-block-end: 1px solid var(--reader-rule);
  }

  .annotated-code__file-header h3,
  .annotated-code__file-header p {
    margin: 0;
  }

  .annotated-code__file-header .annotated-code__status {
    margin-block-start: 0.55rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .annotated-code__status code {
    color: var(--color-text);
    font-size: 0.94em;
    overflow-wrap: anywhere;
  }

  .annotated-code__evidence {
    max-width: var(--measure);
    margin: var(--space-s) 0 0;
    padding: var(--space-s) var(--space-m) var(--space-s) 2.1rem;
    border: 1px solid var(--reader-rule);
    border-radius: var(--radius);
    background: var(--color-bg-subtle);
    color: var(--color-text-secondary);
    font-size: var(--step--1);
  }

  .annotated-code__evidence li {
    padding-inline-start: 0.2rem;
  }

  .annotated-code__evidence li + li {
    margin-block-start: 0.65rem;
  }

  .annotated-code__evidence strong,
  .annotated-code__evidence span,
  .annotated-code__evidence code {
    display: block;
  }

  .annotated-code__evidence strong {
    color: var(--color-text);
  }

  .annotated-code__evidence span {
    margin-block-start: 0.1rem;
  }

  .annotated-code__evidence code {
    margin-block-start: 0.2rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }

  .annotated-code__source-link {
    display: inline-block;
    margin-block-start: 0.45rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .annotated-code__file-header h3 {
    font-size: var(--step-1);
  }

  .annotated-code__file-header p {
    max-width: var(--measure);
    margin-block-start: 0.3rem;
    color: var(--color-text-secondary);
    font-size: var(--step--1);
  }

  .annotated-code__file-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-s);
  }

  .annotated-code__file-actions a,
  .annotated-code__file-actions button,
  .annotated-code__collapse {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .annotated-code__file-actions button,
  .annotated-code__collapse {
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--reader-rule);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }

  .annotated-code__file-actions button:hover,
  .annotated-code__collapse:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .annotated-code__file-actions button:focus-visible,
  .annotated-code__collapse:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .annotated-code__hide-label,
  .annotated-code__collapse {
    display: none;
  }

  .annotated-code__panel[data-file-expanded="true"]
    .annotated-code__show-label {
    display: none;
  }

  .annotated-code__panel[data-file-expanded="true"]
    .annotated-code__hide-label {
    display: inline;
  }

  .annotated-code__file-frame {
    position: relative;
    min-width: 0;
  }

  .annotated-code__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    align-items: start;
    transition: grid-template-columns 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .annotated-code__stage[data-inspector-open="true"] {
    grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 0.8fr);
    gap: var(--space-m);
  }

  .annotated-code__code-window {
    min-width: 0;
  }

  .annotated-code__panel[data-file-expanded="false"]
    .annotated-code__file-frame {
    max-height: 24rem;
    overflow: hidden;
  }

  .annotated-code__preview-fade {
    position: absolute;
    inset: auto 0 0;
    height: 7rem;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-surface) 88%
    );
    pointer-events: none;
  }

  .annotated-code__panel[data-file-expanded="true"]
    .annotated-code__preview-fade {
    display: none;
  }

  .annotated-code__panel[data-file-expanded="true"]
    .annotated-code__collapse {
    display: block;
    margin: var(--space-m) auto 0;
  }

  .annotated-code__file {
    min-width: 0;
    padding-block: var(--space-xs);
    overflow: clip;
    border: 1px solid var(--reader-rule);
    border-block-start: 0;
    background: var(--color-surface);
  }

  .annotated-code__segment {
    display: block;
    scroll-margin-top: 5rem;
  }

  .annotated-code__source-trigger {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.5rem;
    width: 100%;
    min-width: 0;
    padding: 0;
    cursor: pointer;
    outline: none;
    transition:
      background-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .annotated-code__source-trigger:focus-visible {
    z-index: 2;
    box-shadow: inset 0 0 0 3px var(--color-accent);
  }

  .annotated-code__source-trigger:hover {
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-bg));
  }

  .annotated-code__segment[data-expanded="true"]
    > .annotated-code__source-trigger {
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-bg));
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  .annotated-code__section-cue {
    display: grid;
    padding: 0.65rem 0.4rem;
    align-content: start;
    align-items: center;
    border-inline-start: 1px solid var(--reader-rule);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .annotated-code__cue-action {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-secondary);
  }

  .annotated-code__cue-close {
    display: none;
  }

  .annotated-code__chevron {
    display: inline-block;
    color: var(--color-accent);
    font-size: 1rem;
    line-height: 1;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
