---
// An asciinema recording embedded in the article's reading path. The
// companion page keeps its own inline player setup; this component exists so
// the article can hold the Worker-kill recording without duplicating that
// page's section machinery. Options ride on data attributes so one script
// serves every instance on a page.
//
// `notes` maps a marker index to a status line shown under the player from
// that marker until the next one fires. The recording keeps real timing, and
// the longest stretch is Temporal waiting out the heartbeat timeout; without
// a note that pause reads as the demo stalling.
import "asciinema-player/dist/bundle/asciinema-player.css";

interface Props {
  src: string;
  poster: string;
  markers: [number, string][];
  notes?: Record<number, string>;
  cols?: number;
  rows?: number;
}

const { src, poster, markers, notes = {}, cols = 120, rows = 38 } = Astro.props;
---

<figure class="cast-player">
  <div
    class="cast-player__mount"
    data-cast-src={src}
    data-cast-poster={poster}
    data-cast-cols={cols}
    data-cast-rows={rows}
    data-cast-markers={JSON.stringify(markers)}
    data-cast-notes={JSON.stringify(notes)}
  >
  </div>
  <p class="cast-player__note" hidden></p>
  <figcaption><slot /></figcaption>
</figure>

<script>
  import * as AsciinemaPlayer from "asciinema-player";

  for (const mount of document.querySelectorAll<HTMLElement>(
    ".cast-player__mount",
  )) {
    const { castSrc, castPoster, castCols, castRows, castMarkers, castNotes } =
      mount.dataset;
    if (!castSrc) continue;
    const player = AsciinemaPlayer.create(castSrc, mount, {
      cols: Number(castCols),
      rows: Number(castRows),
      preload: true,
      poster: castPoster,
      fit: "width",
      markers: JSON.parse(castMarkers ?? "[]"),
    });
    const notes: Record<number, string> = JSON.parse(castNotes ?? "{}");
    const note = mount.parentElement?.querySelector<HTMLElement>(
      ".cast-player__note",
    );
    if (note && Object.keys(notes).length > 0) {
      player.addEventListener("marker", ({ index }: { index: number }) => {
        const text = notes[index];
        if (text) {
          note.textContent = text;
          note.hidden = false;
        } else {
          note.hidden = true;
        }
      });
      player.addEventListener("ended", () => {
        note.hidden = true;
      });
    }
  }
</script>

<style>
  /* A 120x38 terminal keeps its aspect ratio, so bounding the width is what
     bounds the height. */
  .cast-player {
    width: 100%;
    min-width: 0;
    max-width: 52rem;
    margin-block: var(--space-l);
    margin-inline: auto;
  }

  .cast-player :global(.ap-player) {
    max-width: 100%;
    border: var(--border-hairline);
    border-radius: var(--radius-l);
  }

  .cast-player__note {
    margin-block: var(--space-xs) 0;
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--color-accent);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .cast-player figcaption {
    margin-block-start: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
