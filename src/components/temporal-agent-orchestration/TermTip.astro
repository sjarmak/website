---
// An inline code term with a plain-language explanation on hover or keyboard
// focus. The term is focusable so the tooltip is reachable without a mouse,
// and the tip is wired in with aria-describedby so a screen reader announces
// it with the term instead of finding it later as stray text.

interface Props {
  /** Unique slug for this term on the page; becomes the tooltip's id. */
  term: string;
  /** The plain-language explanation. */
  tip: string;
}

const { term, tip } = Astro.props;
const tipId = `termtip-${term}`;
---

<span class="termtip">
  <code class="termtip__term" tabindex="0" aria-describedby={tipId}><slot /></code>
  <span class="termtip__tip" role="tooltip" id={tipId}>{tip}</span>
</span>

<style>
  .termtip {
    /* inline-block, not inline: an inline box is an unreliable containing
       block for the absolutely positioned tip, and the code term never
       line-wraps anyway. */
    display: inline-block;
    position: relative;
  }

  .termtip__term {
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .termtip__term:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Default, and the no-JavaScript path: the tip is positioned against the
     term. Correct, but an absolutely positioned box adds to the document's
     scrollable width even while hidden, so a term near the right edge of a
     narrow screen leaves the page scrollable sideways. The script below
     upgrades every tip to fixed positioning, which has no such effect and can
     be clamped into the viewport. A wider cap than the previous 24rem wraps
     the definition into fewer lines, which matters here: a floating tip has
     no other way to avoid covering nearby prose, so a shorter box covers
     less of it. */
  .termtip__tip {
    position: absolute;
    bottom: calc(100% + 0.6rem);
    left: 0;
    /* Above the sticky site header (z-index 50): a term scrolled just under
       the header must not have its explanation slide beneath it. */
    z-index: 60;
    width: max-content;
    max-width: min(28rem, 90vw);
    padding: var(--space-xs) var(--space-s);
    border: var(--border-hairline);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--step--1);
    line-height: var(--leading-relaxed);
    box-shadow: 0 3px 14px color-mix(in srgb, var(--color-text) 10%, transparent);
    opacity: 0;
    visibility: hidden;
    transition: opacity 120ms ease;
    pointer-events: none;
  }

  .termtip:hover .termtip__tip,
  .termtip:focus-within .termtip__tip {
    opacity: 1;
    visibility: visible;
  }

  .termtip--floating .termtip__tip {
    position: fixed;
    bottom: auto;
    /* Parked off-screen until the first hover measures and places it. */
    top: -9999px;
    left: 0;
  }

  /* A floating tip has to land on top of whatever prose is already there;
     without a visible connector, that reads as a stray misplaced box rather
     than an explanation of the specific term underneath the cursor. The
     caret is a 45°-rotated square, half showing, sharing the tip's own
     border and background so it reads as one continuous shape. */
  .termtip__tip::after {
    content: "";
    position: absolute;
    left: var(--termtip-caret-offset, 1rem);
    width: 0.6rem;
    height: 0.6rem;
    background: var(--color-surface);
    transform: translateX(-50%) rotate(45deg);
  }

  .termtip__tip[data-placement="above"]::after {
    bottom: -0.34rem;
    border-inline-end: var(--border-hairline);
    border-block-end: var(--border-hairline);
  }

  .termtip__tip[data-placement="below"]::after {
    top: -0.34rem;
    border-inline-start: var(--border-hairline);
    border-block-start: var(--border-hairline);
  }

  @media (prefers-reduced-motion: reduce) {
    .termtip__tip {
      transition: none;
    }
  }
</style>

<script>
  const GUTTER = 8;
  const OFFSET = 10;
  const CARET_MARGIN = 14;

  for (const root of document.querySelectorAll(".termtip")) {
    const tip = root.querySelector(".termtip__tip");
    if (!(tip instanceof HTMLElement)) continue;

    root.classList.add("termtip--floating");

    const place = () => {
      const anchor = root.getBoundingClientRect();
      const box = tip.getBoundingClientRect();
      const viewport = document.documentElement.clientWidth;

      const left = Math.max(
        GUTTER,
        Math.min(anchor.left, viewport - GUTTER - box.width),
      );
      // Above the term, unless the term is too close to the top to fit it.
      const above = anchor.top - box.height - OFFSET;
      const placeAbove = above >= GUTTER;
      const top = placeAbove ? above : anchor.bottom + OFFSET;

      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
      tip.dataset.placement = placeAbove ? "above" : "below";

      // Point the caret at the anchor's own horizontal center, clamped so it
      // never lands past the tip's rounded corners.
      const anchorCenter = anchor.left + anchor.width / 2 - left;
      const caretOffset = Math.max(
        CARET_MARGIN,
        Math.min(anchorCenter, box.width - CARET_MARGIN),
      );
      tip.style.setProperty("--termtip-caret-offset", `${caretOffset}px`);
    };

    root.addEventListener("pointerenter", place);
    root.addEventListener("focusin", place);
  }
</script>
