---
// An inline code term with a plain-language explanation on hover or keyboard
// focus. The term is focusable so the tooltip is reachable without a mouse,
// and the tip is wired in with aria-describedby so a screen reader announces
// it with the term instead of finding it later as stray text.

interface Props {
  /** Unique slug for this term on the page; becomes the tooltip's id. */
  term: string;
  /** The plain-language explanation. */
  tip: string;
}

const { term, tip } = Astro.props;
const tipId = `termtip-${term}`;
---

<span class="termtip">
  <code class="termtip__term" tabindex="0" aria-describedby={tipId}><slot /></code>
  <span class="termtip__tip" role="tooltip" id={tipId}>{tip}</span>
</span>

<style>
  .termtip {
    /* inline-block, not inline: an inline box is an unreliable containing
       block for the absolutely positioned tip, and the code term never
       line-wraps anyway. */
    display: inline-block;
    position: relative;
  }

  .termtip__term {
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .termtip__term:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .termtip__tip {
    position: absolute;
    bottom: calc(100% + 0.6rem);
    left: 0;
    /* Above the sticky site header (z-index 50): a term scrolled just under
       the header must not have its explanation slide beneath it. */
    z-index: 60;
    width: max-content;
    max-width: min(24rem, 82vw);
    padding: var(--space-xs) var(--space-s);
    border: var(--border-hairline);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--step--1);
    line-height: var(--leading-relaxed);
    box-shadow: 0 3px 14px color-mix(in srgb, var(--color-text) 10%, transparent);
    opacity: 0;
    visibility: hidden;
    transition: opacity 120ms ease;
    pointer-events: none;
  }

  .termtip:hover .termtip__tip,
  .termtip:focus-within .termtip__tip {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .termtip__tip {
      transition: none;
    }
  }
</style>
