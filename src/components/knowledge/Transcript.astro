---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"transcripts">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const meta = [
  entry.data.durationMin ? `${Math.round(entry.data.durationMin)} min` : null,
  entry.data.words ? `${entry.data.words.toLocaleString()} words` : null,
].filter(Boolean);
---

<details class="transcript">
  <summary class="transcript__summary">
    <span class="transcript__label">Read transcript</span>
    {meta.length > 0 && <span class="transcript__meta">{meta.join(" · ")}</span>}
  </summary>
  <div class="prose transcript__body">
    <Content />
  </div>
</details>

<style>
  .transcript {
    margin-block-start: var(--space-s);
    border: var(--border-hairline);
    border-radius: var(--radius);
    background: var(--color-bg-subtle);
  }

  .transcript__summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-s);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-secondary);
    user-select: none;
  }

  .transcript__summary:hover {
    color: var(--color-accent);
  }

  .transcript__label::before {
    content: "📄 ";
  }

  .transcript__meta {
    color: var(--color-text-muted);
    font-size: var(--step--2);
  }

  .transcript[open] .transcript__summary {
    border-bottom: var(--border-hairline);
  }

  .transcript__body {
    padding: var(--space-m) var(--space-s);
    max-height: 32rem;
    overflow-y: auto;
  }
</style>
