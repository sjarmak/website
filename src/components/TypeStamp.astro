---
// The ONE sitewide type stamp (PRD R16). Rendered by BaseLayout for every page
// from its register declaration; all visitor-facing wording comes from the
// canonical map in src/lib/registerCopy.ts — no phrasing lives here.
import type { Register } from "@/lib/register";
import { REGISTER_COPY, STAMP_UPDATED_PREFIX } from "@/lib/registerCopy";

interface Props {
  register: Register;
  /** Optional last-updated date, rendered as "· updated YYYY-MM-DD". */
  updated?: Date;
}

const { register, updated } = Astro.props;
const copy = REGISTER_COPY[register];
const updatedIso = updated ? updated.toISOString().slice(0, 10) : null;
---

<div
  class={`container type-stamp type-stamp--${copy.stampPlacement}`}
  data-register={register}
>
  <p class="type-stamp__line">
    <span class="type-stamp__label">{copy.label}</span>
    <span class="type-stamp__copy">· {copy.badgeCopy}</span>
    {
      updatedIso && (
        <span class="type-stamp__updated">
          · {STAMP_UPDATED_PREFIX} <time datetime={updatedIso}>{updatedIso}</time>
        </span>
      )
    }
  </p>
</div>

<style>
  .type-stamp__line {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }

  .type-stamp__label {
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Visible placement near the top meta area (generated / hybrid / reference / lab). */
  .type-stamp--header {
    padding-block: var(--space-xs);
    border-bottom: var(--border-hairline);
  }

  /* Quiet placement in the footer region (authored pages — the personal
     register is never visually co-labeled with the machine one). */
  .type-stamp--footer-quiet {
    padding-block: var(--space-xs) var(--space-l);
  }

  .type-stamp--footer-quiet .type-stamp__line {
    opacity: 0.75;
  }
</style>
