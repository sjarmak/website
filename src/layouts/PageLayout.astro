---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  /** Short eyebrow label above the page title. */
  kicker?: string;
  /** Intro line under the page title. */
  intro?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, kicker, intro, image, noindex } = Astro.props;
---

<BaseLayout title={title} description={description ?? intro} image={image} noindex={noindex}>
  <div class="container">
    <header class="page-head stack stack-s">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {intro && <p class="lead measure">{intro}</p>}
    </header>
    <slot />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(var(--space-l), 6vw, var(--space-2xl)) var(--space-l);
  }
</style>
