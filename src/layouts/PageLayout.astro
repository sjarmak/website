---
import BaseLayout from "./BaseLayout.astro";
import type { Register } from "@/lib/register";

interface Props {
  title: string;
  description?: string;
  /** Short eyebrow label above the page title. */
  kicker?: string;
  /** Intro line under the page title. */
  intro?: string;
  image?: string;
  noindex?: boolean;
  /** REQUIRED register declaration (PRD R3) — threaded to BaseHead's meta tag. */
  register: Register;
}

const { title, description, kicker, intro, image, noindex, register } = Astro.props;
---

<BaseLayout
  title={title}
  description={description ?? intro}
  image={image}
  noindex={noindex}
  register={register}
>
  <div class="container">
    <header class="page-head stack stack-s">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {intro && <p class="lead measure">{intro}</p>}
    </header>
    <slot />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(var(--space-l), 6vw, var(--space-2xl)) var(--space-l);
  }
</style>
