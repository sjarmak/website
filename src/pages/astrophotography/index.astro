---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/PageLayout.astro";
import EmptyState from "@/components/primitives/EmptyState.astro";
import { getCollection } from "astro:content";

const photos = (await getCollection("astrophoto")).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
---

<PageLayout
  title="Astrophotography"
  kicker="The night sky"
  intro="The Moon at high magnification, stacked and processed to bring out the mineral color in the maria and the detail along the terminator. Just lunar plates for now, with more of the sky to come. Click any plate to expand it."
  description="Astrophotography by Stephanie Jarmak."
>
  {
    photos.length === 0 ? (
      <EmptyState
        title="The gallery is being prepared"
        note="Plates are processed and uploaded as Markdown entries with their capture details (target, gear, exposure)."
      />
    ) : (
      <ul role="list" class="plates">
        {photos.map((photo) => (
          <li class="plate">
            <a
              href={photo.data.remoteFull ?? photo.data.image.src}
              class="plate__link"
              data-plate-link
              data-alt={photo.data.caption ?? photo.data.title}
              aria-label={`Expand ${photo.data.title}`}
            >
              <Image
                src={photo.data.image}
                alt={photo.data.caption ?? photo.data.title}
                widths={[400, 800, 1200]}
                sizes="(max-width: 700px) 100vw, 360px"
                class="plate__img"
                loading="lazy"
              />
            </a>
            <figcaption class="plate__cap">
              <span class="plate__title">{photo.data.title}</span>
              {photo.data.target && <span class="muted"> · {photo.data.target}</span>}
            </figcaption>
          </li>
        ))}
      </ul>
    )
  }

  <div
    class="lightbox"
    data-lightbox-overlay
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Expanded plate"
  >
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">×</button>
    <img class="lightbox__img" data-lightbox-img alt="" />
  </div>

  <script>
    import "@/scripts/lightbox";
  </script>
</PageLayout>

<style>
  .plates {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-m);
  }
  .plate {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .plate__link {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: var(--border-hairline);
    cursor: zoom-in;
  }
  .plate__img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .plate__cap {
    font-size: var(--step--1);
  }
  .plate__title {
    font-family: var(--font-display);
  }

  /* ---- lightbox ---- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: clamp(var(--space-s), 4vw, var(--space-xl));
    background: oklch(14% 0.012 70 / 0.92);
    backdrop-filter: blur(4px);
    cursor: zoom-out;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__img {
    max-width: min(96vw, 1400px);
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 12px 48px oklch(0% 0 0 / 0.5);
    cursor: default;
    animation: lightbox-in 160ms ease;
  }
  .lightbox__close {
    position: absolute;
    top: var(--space-s);
    right: var(--space-m);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--paper-50);
    background: none;
    border: none;
    cursor: pointer;
  }
  .lightbox__close:hover {
    color: var(--ember-300);
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox__img {
      animation: none;
    }
  }
</style>
