---
import PageLayout from "@/layouts/PageLayout.astro";
import EmptyState from "@/components/primitives/EmptyState.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("learning");
const sortByOrder = (a: { data: { order?: number } }, b: { data: { order?: number } }) =>
  (a.data.order ?? 999) - (b.data.order ?? 999);

const explorers = entries.filter((e) => e.data.kind === "explorer").sort(sortByOrder);
const podcasts = entries.filter((e) => e.data.kind === "podcast").sort(sortByOrder);

// Group podcasts by series (episodes within a series, then standalone).
const seriesNames = [...new Set(podcasts.map((p) => p.data.series).filter(Boolean))] as string[];
const standalone = podcasts.filter((p) => !p.data.series);
---

<PageLayout
  title="Learning"
  kicker="Explore & listen"
  intro="Interactive surveys of the literature, and generated deep-dive podcasts, ways into the topics I work on."
  description="Literature explorers and deep-dive podcasts by Stephanie Jarmak."
>
  <div class="stack stack-l">
    <section>
      <h2 class="sub">Literature explorers</h2>
      <p class="muted measure" style="margin-block-end: var(--space-m)">
        Navigable, themed maps of recent research, built with SciX MCP and code-intel sources.
      </p>
      <ul role="list" class="auto-grid" style="--grid-min: 17rem; --grid-gap: var(--space-m)">
        {
          explorers.map((e) => (
            <li class="card">
              <a href={e.data.url} rel="noopener" class="card__link">
                <h3 class="card__title">{e.data.title}</h3>
              </a>
              <p class="muted">{e.data.description}</p>
              {e.data.meta && <p class="card__meta">{e.data.meta}</p>}
              <p class="card__cta">
                <a href={e.data.url} rel="noopener">Explore ↗</a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="sub">Podcasts</h2>
      {
        podcasts.length === 0 ? (
          <EmptyState
            title="Deep-dive podcasts are being added"
            note="A 5-episode series on agentic memory and a foundations deep dive will live here."
          />
        ) : (
          <div class="stack stack-l">
            {seriesNames.map((series) => (
              <div>
                <h3 class="series">{series}</h3>
                <ul role="list" class="stack">
                  {podcasts
                    .filter((p) => p.data.series === series)
                    .map((p) => (
                      <li class="ep">
                        <div class="ep__head">
                          <span class="ep__title">
                            {p.data.episode ? `${p.data.episode}. ` : ""}
                            {p.data.title}
                          </span>
                        </div>
                        <p class="muted">{p.data.description}</p>
                        {p.data.embedUrl && (
                          <iframe class="ep__embed" src={p.data.embedUrl} loading="lazy" title={p.data.title} />
                        )}
                        {!p.data.embedUrl && p.data.audioUrl && (
                          <audio controls preload="none">
                            <source src={p.data.audioUrl} type="audio/mpeg" />
                          </audio>
                        )}
                      </li>
                    ))}
                </ul>
              </div>
            ))}
            {standalone.map((p) => (
              <div class="ep">
                <span class="ep__title">{p.data.title}</span>
                <p class="muted">{p.data.description}</p>
                {p.data.embedUrl && (
                  <iframe class="ep__embed" src={p.data.embedUrl} loading="lazy" title={p.data.title} />
                )}
                {!p.data.embedUrl && p.data.audioUrl && (
                  <audio controls preload="none" src={p.data.audioUrl} />
                )}
              </div>
            ))}
          </div>
        )
      }
    </section>
  </div>
</PageLayout>

<style>
  .sub {
    font-size: var(--step-2);
    margin-block-end: var(--space-2xs);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m);
    border: var(--border-hairline);
    border-radius: var(--radius-l);
    background: var(--color-bg-subtle);
  }
  .card__link {
    text-decoration: none;
    color: var(--color-text);
  }
  .card__title {
    font-size: var(--step-1);
  }
  .card__link:hover .card__title {
    color: var(--color-accent);
  }
  .card__meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
  .card__cta {
    margin-block-start: auto;
  }
  .series {
    font-size: var(--step-1);
    margin-block-end: var(--space-s);
  }
  .ep {
    padding-block: var(--space-s);
    border-bottom: var(--border-hairline);
  }
  .ep__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .ep__embed {
    width: 100%;
    height: 152px;
    border: 0;
    border-radius: var(--radius);
    margin-block-start: var(--space-s);
  }
  audio {
    width: 100%;
    margin-block-start: var(--space-s);
  }
</style>
