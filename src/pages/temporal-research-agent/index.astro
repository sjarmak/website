    color: var(--shiki-dark) !important;
  }

  .tra__evidence img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-hairline);
    border-radius: var(--radius);
  }

  .tra__expand {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
