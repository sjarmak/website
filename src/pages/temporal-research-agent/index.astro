    border-block: var(--border-hairline);
  }

  .tra__run div {
    min-width: 0;
    padding: var(--space-s);
    border-inline-end: var(--border-hairline);
  }

  .tra__run div:last-child {
    border-inline-end: 0;
  }

  .tra__run dt {
