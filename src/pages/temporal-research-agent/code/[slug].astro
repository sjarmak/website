---
import { readFileSync } from "node:fs";
import path from "node:path";
import { codeToHtml } from "shiki";

import {
  temporalResearchCodeSamples,
  type TemporalCodeSample,
} from "@/data/temporal-research-code-samples";
import PageLayout from "@/layouts/PageLayout.astro";

export function getStaticPaths() {
  return temporalResearchCodeSamples.map((sample) => ({
    params: { slug: sample.slug },
    props: { sample },
  }));
}

interface Props {
  sample: TemporalCodeSample;
}

const { sample } = Astro.props;
const root = "/temporal-research-agent";
const source = readFileSync(path.join(process.cwd(), sample.sourcePath), "utf8")
  .replace(/\n$/, "");
const lines = source.split("\n");

let expectedStart = 1;
for (const section of sample.sections) {
  if (section.start !== expectedStart || section.end < section.start) {
    throw new Error(`Non-contiguous annotations in ${sample.filename}`);
  }
  expectedStart = section.end + 1;
}
if (expectedStart !== lines.length + 1) {
  throw new Error(
    `${sample.filename} has ${lines.length} lines but annotations end at ${expectedStart - 1}`,
  );
}

const renderedSections = await Promise.all(
  sample.sections.map(async (section) => ({
    ...section,
    html: await codeToHtml(
      lines.slice(section.start - 1, section.end).join("\n"),
      {
        lang: sample.language,
        themes: {
          light: "github-light",
          dark: "github-dark",
        },
      },
    ),
  })),
);
---

<PageLayout
  title={sample.title}
  kicker={sample.kicker}
  intro={sample.summary}
  description={`${sample.title}, shown in full with semantic annotations for developers learning Temporal.`}
  noindex={true}
>
  <article class="code-reader">
    <nav class="code-reader__utility" aria-label="Code sample links">
      <a href={`${root}/#code-comparison`}>← Case study</a>
      <span>{sample.filename}</span>
      <a
        class="code-reader__download"
        href={sample.rawPath}
        download={sample.filename}
      >
        Download raw <span aria-hidden="true">↓</span>
      </a>
    </nav>

    <section class="code-reader__guide" aria-labelledby="reader-guide">
      <div>
        <p class="kicker">How to read this file</p>
        <h2 id="reader-guide">Follow the execution boundary</h2>
      </div>
      <p>
        Mouse over, focus, or tap a code section to bring its explanation
        forward. Every line is shown, and every explanation remains available
        without interaction.
      </p>
    </section>

    <nav class="code-reader__samples" aria-label="Code samples">
      {
        temporalResearchCodeSamples.map((candidate) => (
          <a
            href={`${root}/code/${candidate.slug}`}
            title={candidate.filename}
            aria-current={candidate.slug === sample.slug ? "page" : undefined}
          >
            <span>{candidate.slug === "before" ? "Before" : "After"}</span>
            {candidate.filename}
          </a>
        ))
      }
    </nav>

    <div class="code-reader__file">
      {
        renderedSections.map((section) => (
          <section
            class="code-reader__segment"
            tabindex="0"
            aria-labelledby={`${sample.slug}-section-${section.start}`}
          >
            <aside class="code-reader__annotation">
              <p class="code-reader__line-range">
                Lines {section.start}–{section.end}
              </p>
              <h2 id={`${sample.slug}-section-${section.start}`}>
                {section.title}
              </h2>
              <dl>
                <div>
                  <dt>What this section does</dt>
                  <dd>{section.purpose}</dd>
                </div>
                <div>
                  <dt>Why it matters for Temporal</dt>
                  <dd>{section.whyTemporal}</dd>
                </div>
              </dl>
              <ul aria-label="Section concepts">
                {section.details.map((detail) => <li>{detail}</li>)}
              </ul>
            </aside>
            <div
              class="code-reader__source"
              style={`--start-line: ${section.start}`}
              set:html={section.html}
            />
          </section>
        ))
      }
    </div>

    <footer class="code-reader__footer">
      <p>
        This rendered view and the download are generated from the same source
        file packaged with the case study.
      </p>
      <a href={sample.rawPath} download={sample.filename}>
        Download {sample.filename} <span aria-hidden="true">↓</span>
      </a>
    </footer>
  </article>
</PageLayout>

<style>
  .code-reader {
    --reader-rule: color-mix(in srgb, var(--color-text) 18%, transparent);
    padding-block-end: var(--space-3xl);
  }

  .code-reader > * + * {
    margin-block-start: clamp(var(--space-l), 6vw, var(--space-2xl));
  }

  .code-reader__utility {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 3.75rem;
    align-items: center;
    border-block: var(--border-hairline);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .code-reader__utility > * {
    padding: var(--space-xs) var(--space-s);
  }

  .code-reader__utility > span {
    color: var(--color-text-muted);
  }

  .code-reader__utility a {
    color: var(--color-text);
    text-decoration: none;
  }

  .code-reader__utility a:hover {
    color: var(--color-accent);
  }

  .code-reader__download {
    justify-self: end;
  }

  .code-reader__guide {
    display: grid;
    grid-template-columns: minmax(15rem, 4fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .code-reader__guide .kicker,
  .code-reader__guide h2,
  .code-reader__guide p {
    margin: 0;
  }

  .code-reader__guide p {
    max-width: var(--measure);
    color: var(--color-text-secondary);
    font-size: var(--step-1);
    line-height: var(--leading-relaxed);
  }

  .code-reader__samples {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--reader-rule);
  }

  .code-reader__samples a {
    display: grid;
    min-width: 0;
    padding: var(--space-s);
    gap: 0.2rem;
    border-inline-end: 1px solid var(--reader-rule);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    white-space: nowrap;
  }

  .code-reader__samples a:last-child {
    border-inline-end: 0;
  }

  .code-reader__samples a span {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .code-reader__samples a:hover,
  .code-reader__samples a[aria-current="page"] {
    background: var(--color-bg-subtle);
    color: var(--color-text);
  }

  .code-reader__samples a[aria-current="page"] {
    box-shadow: inset 0 -3px var(--color-accent);
  }

  .code-reader__file {
    border: 1px solid var(--reader-rule);
    background: var(--color-surface);
  }

  .code-reader__segment {
    display: grid;
    grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.7fr);
    outline: none;
    scroll-margin-top: 5rem;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease;
  }

  .code-reader__segment + .code-reader__segment {
    border-top: 1px solid var(--reader-rule);
  }

  .code-reader__annotation {
    position: relative;
    z-index: 1;
    padding: clamp(var(--space-m), 3vw, var(--space-l));
    border-inline-end: 1px solid var(--reader-rule);
    background: var(--color-bg-subtle);
  }

  .code-reader__line-range {
    margin: 0 0 var(--space-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .code-reader__annotation h2 {
    margin: 0;
    font-size: var(--step-1);
  }

  .code-reader__annotation dl {
    margin: var(--space-m) 0 0;
  }

  .code-reader__annotation dl div + div {
    margin-block-start: var(--space-s);
  }

  .code-reader__annotation dt {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .code-reader__annotation dd {
    margin: 0.3rem 0 0;
    color: var(--color-text-secondary);
    font-size: var(--step--1);
    line-height: var(--leading-relaxed);
  }

  .code-reader__annotation ul {
    display: flex;
    flex-wrap: wrap;
    margin: var(--space-s) 0 0;
    padding: 0;
    gap: 0.35rem;
    list-style: none;
  }

  .code-reader__annotation li {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--reader-rule);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .code-reader__source {
    min-width: 0;
    padding-block: var(--space-m);
    overflow-x: auto;
    background: color-mix(in srgb, var(--color-bg) 92%, var(--color-text));
  }

  .code-reader__source :global(.shiki) {
    min-width: max-content;
    margin: 0;
    padding: 0 var(--space-m);
    background: transparent !important;
    font-size: clamp(0.74rem, 1.25vw, 0.88rem);
    line-height: 1.75;
  }

  .code-reader__source :global(code) {
    counter-reset: line calc(var(--start-line) - 1);
  }

  .code-reader__source :global(.line) {
    display: inline-block;
    width: 100%;
    padding-inline-end: var(--space-m);
  }

  .code-reader__source :global(.line::before) {
    display: inline-block;
    width: 3ch;
    margin-inline-end: var(--space-m);
    color: var(--color-text-muted);
    content: counter(line);
    counter-increment: line;
    text-align: end;
    user-select: none;
  }

  .code-reader__source :global(.shiki span) {
    color: var(--shiki-light) !important;
  }

  :global([data-theme="dark"]) .code-reader__source :global(.shiki span) {
    color: var(--shiki-dark) !important;
  }

  .code-reader__segment:focus-visible {
    box-shadow: inset 0 0 0 3px var(--color-accent);
  }

  .code-reader__segment:focus .code-reader__annotation {
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg-subtle));
  }

  .code-reader__segment:focus .code-reader__source {
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-bg));
  }

  @media (hover: hover) {
    .code-reader__segment:hover .code-reader__annotation {
      background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg-subtle));
    }

    .code-reader__segment:hover .code-reader__source {
      background: color-mix(in srgb, var(--color-accent) 5%, var(--color-bg));
    }
  }

  .code-reader__footer {
    display: flex;
    padding-block: var(--space-m);
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    border-block: var(--border-hairline);
  }

  .code-reader__footer p {
    max-width: var(--measure);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .code-reader__footer a {
    flex: none;
  }

  @media (max-width: 800px) {
    .code-reader__guide {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }

    .code-reader__samples {
      grid-template-columns: repeat(2, 1fr);
    }

    .code-reader__samples a:nth-child(2) {
      border-inline-end: 0;
    }

    .code-reader__samples a:nth-child(-n + 2) {
      border-block-end: 1px solid var(--reader-rule);
    }

    .code-reader__segment {
      grid-template-columns: 1fr;
    }

    .code-reader__annotation {
      border-inline-end: 0;
      border-block-end: 1px solid var(--reader-rule);
    }
  }

  @media (max-width: 520px) {
    .code-reader__utility {
      grid-template-columns: 1fr auto;
    }

    .code-reader__utility > span {
      display: none;
    }

    .code-reader__samples {
      grid-template-columns: 1fr;
    }

    .code-reader__samples a,
    .code-reader__samples a:nth-child(2) {
      border-inline-end: 0;
      border-block-end: 1px solid var(--reader-rule);
    }

    .code-reader__samples a:last-child {
      border-block-end: 0;
    }

    .code-reader__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .code-reader__segment {
      transition: none;
    }
  }
</style>
