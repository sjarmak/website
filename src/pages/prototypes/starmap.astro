---
import PageLayout from "@/layouts/PageLayout.astro";
import { buildStarmap } from "@/lib/starmap/buildStarmap";
import type { StarKind } from "@/lib/starmap/buildStarmap";

const { points } = await buildStarmap();

const kindOrder: StarKind[] = ["topic", "project", "writing", "talk", "publication", "learning"];

const kindLabels: Record<StarKind, string> = {
  topic: "Topic",
  project: "Project",
  writing: "Writing",
  talk: "Talk",
  publication: "Publication",
  learning: "Learning",
};

// Group for accessible fallback
const byKind: Record<StarKind, typeof points> = {
  topic: [],
  project: [],
  writing: [],
  talk: [],
  publication: [],
  learning: [],
};
for (const p of points) byKind[p.kind].push(p);
---

<PageLayout
  kicker="Prototype"
  title="Starmap"
  intro="All site content projected into a continuous 2D field — proximity means semantic similarity, clusters reveal themes. Pan to explore, no edges needed."
>
  <div class="starmap-page stack stack-l">

    <div class="starmap-root" data-starmap-root>
      <!-- Inline point data for the client renderer -->
      <script type="application/json" data-starmap-data set:html={JSON.stringify(points)} is:inline
      ></script>

      <div class="canvas-wrap">
        <canvas data-starmap-canvas aria-label="Interactive semantic starmap of site content" role="img" />
      </div>

      <div class="legend cluster" aria-label="Kind colour legend">
        <span class="legend__label">Kind</span>
        <span class="legend__item legend__item--topic">Topic</span>
        <span class="legend__item legend__item--project">Project</span>
        <span class="legend__item legend__item--writing">Writing</span>
        <span class="legend__item legend__item--talk">Talk</span>
        <span class="legend__item legend__item--publication">Publication</span>
        <span class="legend__item legend__item--learning">Learning</span>
      </div>

      <!-- Accessible fallback: shown until canvas activates -->
      <nav class="fallback-list stack stack-l" aria-label="All content by kind" data-starmap-fallback>
        {kindOrder.map((kind) =>
          byKind[kind].length > 0 && (
            <section class="stack stack-s">
              <h2 class="kicker">{kindLabels[kind]}</h2>
              <ul class="fallback-items">
                {byKind[kind].map((p) => (
                  <li>
                    <a href={p.url}>{p.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        )}
      </nav>
    </div>

    <p class="hint muted">
      <strong>{points.length}</strong> items embedded via Jaccard similarity over tag and topic bags.
      Scroll to zoom · drag to pan · click any point to navigate.
    </p>

  </div>
</PageLayout>

<script>
  import "@/scripts/starmap";
</script>

<style>
  .starmap-page {
    padding-block: var(--space-m) var(--space-2xl);
  }

  .starmap-root {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .canvas-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: min(72vh, 680px);
    border-radius: var(--radius-l);
    border: var(--border-hairline);
    overflow: hidden;
    background: var(--graph-bg, #fbf8f2);
  }

  canvas[data-starmap-canvas] {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Legend */
  .legend {
    --cluster-gap: var(--space-s);
    font-size: var(--step--1);
    color: var(--color-text-secondary);
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-bg-subtle);
    border: var(--border-hairline);
    border-radius: var(--radius);
    flex-wrap: wrap;
    align-items: center;
  }

  .legend__label {
    color: var(--color-text-muted);
    font-family: var(--font-mono, monospace);
    font-size: calc(var(--step--1) * 0.9);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-inline-end: var(--space-2xs);
  }

  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }

  .legend__item::before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Dot colours match the canvas readTokens() mapping */
  .legend__item--topic::before    { background: var(--graph-node-topic); }
  .legend__item--project::before  { background: var(--graph-node-project); }
  .legend__item--writing::before  { background: var(--graph-node-output); }
  /* talk and learning use adjusted variants — approximate in CSS */
  .legend__item--talk::before        { background: color-mix(in srgb, var(--graph-node-output) 85%, white 15%); }
  .legend__item--publication::before { background: color-mix(in srgb, var(--graph-node-project) 80%, black 20%); }
  .legend__item--learning::before    { background: color-mix(in srgb, var(--graph-node-topic) 70%, white 30%); }

  /* Fallback list — hidden when canvas is active */
  .fallback-list {
    padding-block: var(--space-m);
  }

  [data-starmap-root][data-canvas-active="true"] .fallback-list {
    display: none;
  }

  .fallback-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .fallback-items a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .fallback-items a:hover {
    text-decoration: underline;
  }

  .hint {
    font-size: var(--step--1);
  }
</style>
