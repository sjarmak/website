---
import PageLayout from "@/layouts/PageLayout.astro";
import { getScixExplorers } from "@/lib/knowledge/scix-ab";
const explorers = getScixExplorers();
---
<PageLayout title="SciX advisory board explorers" kicker="Fields & reading paths" noindex
  intro="Eleven routes into the board’s research interests. Follow a field from its foundations to current questions, explore the papers, or listen to the companion episode.">
  <ol class="people" role="list">
    {explorers.map((explorer) => (
      <li class="person" data-person-card>
        <div class="identity">
          <h2><a href={explorer.homepage}>{explorer.person.name}</a></h2>
          <p class="muted">{explorer.person.affiliation}</p>
        </div>
        <div class="field">
          <h3><a href={explorer.homepage}>{explorer.title}</a></h3>
          <p class="measure">{explorer.person.expertise}</p>
          <p class="interests muted">{explorer.person.interests.join(" · ")}</p>
          <p class="meta">{explorer.paperCount} papers · {explorer.themeCount} themes · {Math.round(explorer.podcast.durationMin)} min audio</p>
          <div class="links">
            <a href={explorer.homepage}>Explore the field →</a>
            <a href={`${explorer.homepage}#podcast`}>Listen to the episode</a>
          </div>
        </div>
      </li>
    ))}
  </ol>
</PageLayout>
<style>
  .people { list-style: none; margin: 0; padding: 0 0 var(--space-2xl); }
  .person { display: grid; grid-template-columns: minmax(12rem, 1fr) minmax(0, 2fr); gap: var(--space-l); padding-block: var(--space-l); border-top: var(--border-hairline); }
  h2 { font-size: var(--step-1); margin: 0 0 var(--space-xs); }
  h3 { font-size: var(--step-2); margin: 0 0 var(--space-xs); }
  h2 a, h3 a { color: var(--color-text); text-decoration: none; }
  a:hover { color: var(--color-accent); }
  .identity p, .field p { margin-block: 0 var(--space-s); }
  .interests { font-size: var(--step--1); }
  .meta { font: var(--step--1) var(--font-mono); color: var(--color-text-muted); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-l); }
  .links a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  @media (max-width: 42rem) { .person { grid-template-columns: 1fr; gap: var(--space-s); } }
</style>
