---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/PageLayout.astro";
import EmptyState from "@/components/primitives/EmptyState.astro";
import EmbeddedVideo from "@/components/talks/EmbeddedVideo.astro";
import { getTalks } from "@/lib/collections";
import { monthYear } from "@/lib/dates";

const talks = await getTalks();
---

<PageLayout
  title="Talks"
  kicker="Speaking"
  intro="Webinars, conference talks, and conversations on agents, scientific search, and AI for research."
  description="Talks and webinars by Stephanie Jarmak."
>
  {talks.length === 0 && (
    <EmptyState
      title="Talks are being added"
      note="Recorded webinars and conference talks will appear here."
    />
  )}

  <div class="talks">
    {
      talks.map((t) => (
        <article class="talk">
          {t.data.videoFile ? (
            <figure class="talk__media">
              <video class="talk__video" controls preload="metadata" poster={t.data.videoPoster}>
                <source src={t.data.videoFile} type="video/mp4" />
              </video>
              {t.data.videoCaption && <figcaption class="talk__caption muted">{t.data.videoCaption}</figcaption>}
            </figure>
          ) : (
            t.data.videoId &&
            t.data.videoProvider && (
              <EmbeddedVideo provider={t.data.videoProvider} id={t.data.videoId} title={t.data.title} />
            )
          )}

          <div class="talk__meta stack stack-s">
            <h2 class="talk__title">{t.data.title}</h2>
            <p class="muted">
              {t.data.eventUrl ? (
                <a href={t.data.eventUrl} rel="noopener">
                  {t.data.event}
                </a>
              ) : (
                t.data.event
              )}{" "}
              · {monthYear(t.data.date)}
              {t.data.location && ` · ${t.data.location}`}
            </p>
            {t.data.description && <p class="secondary measure">{t.data.description}</p>}
            {(t.data.videoUrl || t.data.slidesUrl || t.data.scheduleUrl) && (
              <p class="cluster" style="--cluster-gap: var(--space-m)">
                {t.data.videoUrl && (
                  <a href={t.data.videoUrl} rel="noopener">
                    Watch ↗
                  </a>
                )}
                {t.data.slidesUrl && (
                  <a href={t.data.slidesUrl} rel="noopener">
                    Slides ↗
                  </a>
                )}
                {t.data.scheduleUrl && (
                  <a href={t.data.scheduleUrl} rel="noopener">
                    Schedule ↗
                  </a>
                )}
              </p>
            )}
          </div>

          {t.data.photo && (
            <figure class:list={["talk__photo", t.data.photoCard && "talk__photo--card"]}>
              <a
                class="talk__photo-link"
                href={t.data.photo.src}
                target="_blank"
                rel="noopener"
                aria-label={`View full size — ${t.data.photoAlt ?? t.data.title}`}
              >
                <Image
                  src={t.data.photo}
                  alt={t.data.photoAlt ?? `${t.data.title} — ${t.data.event}`}
                  widths={[480, 800, 1200]}
                  sizes={t.data.photoCard ? "(max-width: 50rem) 50vw, 16rem" : "(max-width: 50rem) 100vw, 50rem"}
                />
              </a>
            </figure>
          )}
        </article>
      ))
    }
  </div>
</PageLayout>

<style>
  .talks {
    display: grid;
    gap: var(--space-2xl);
  }
  .talk {
    display: grid;
    gap: var(--space-l);
  }
  .talk + .talk {
    padding-block-start: var(--space-2xl);
    border-top: var(--border-hairline);
  }
  .talk__title {
    font-size: var(--step-2);
  }
  .talk__media {
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
  }
  .talk__video {
    width: 100%;
    aspect-ratio: 1264 / 1080;
    max-height: 70vh;
    border-radius: var(--radius-l);
    border: var(--border-hairline);
    background: var(--color-surface);
    display: block;
  }
  .talk__caption {
    font-size: var(--step--1);
  }
  .talk__photo {
    margin: 0;
  }
  .talk__photo-link {
    display: block;
    cursor: zoom-in;
  }
  .talk__photo img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    border: var(--border-hairline);
    display: block;
  }
  /* Promo/speaker cards are decorative announcements, not presentation photos:
     keep them small instead of full-bleed. Click opens the legible full size. */
  .talk__photo--card img {
    width: 100%;
    max-width: 16rem;
  }
</style>
