---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { bookExploreHref } from "@/lib/books";

export async function getStaticPaths() {
  const [books, companions] = await Promise.all([
    getCollection("books"),
    getCollection("bookCompanions"),
  ]);
  const booksById = new Map(books.map((book) => [book.id, book]));

  return companions.map((companion) => {
    const book = booksById.get(companion.data.book.id);
    if (!book) throw new Error(`Missing book for companion ${companion.id}`);
    return {
      params: { book: book.id },
      props: { book, companion },
    };
  });
}

interface Props {
  book: CollectionEntry<"books">;
  companion: CollectionEntry<"bookCompanions">;
}

const { book, companion } = Astro.props;
const { Content } = await render(companion);
---

<BaseLayout
  title={`${companion.data.title} · ${book.data.title}`}
  description={`The complete catalog of ${companion.data.practiceCount} practices associated with ${book.data.title}.`}
  type="article"
>
  <article class="catalog">
    <header class="catalog-head container">
      <div class="catalog-head__context">
        <a href="/writing">Writing</a>
        <span aria-hidden="true">/</span>
        <a href={`/books/${book.id}`}>{book.data.title}</a>
      </div>

      <div class="catalog-head__title">
        <p class="kicker">Book companion</p>
        <h1>{companion.data.title}</h1>
      </div>

      <div class="catalog-head__details">
        <p class="lead">
          Every practice in the book’s corpus, organized beside the chapter that
          develops its underlying mechanism.
        </p>
        <p class="catalog-head__counts" aria-label="Catalog coverage">
          <span>{companion.data.practiceCount} practices</span>
          <span>{companion.data.taughtCount} taught</span>
          <span>{companion.data.untaughtCount} untaught</span>
        </p>
        <a href={`/books/${book.id}`}>Return to the book <span aria-hidden="true">→</span></a>
        <a class="catalog-head__explore" href={bookExploreHref(book.id)}>
          Explore as a graph <span aria-hidden="true">→</span>
        </a>
      </div>
    </header>

    <div class="catalog-layout container">
      <aside class="catalog-index">
        <nav aria-label="Companion chapters">
          <p>Jump to chapter</p>
          <ol>
            {
              companion.data.chapters.map((chapter) => (
                <li>
                  <a href={`#chapter-${chapter.number}`}>
                    <span>{chapter.number}</span>
                    {chapter.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="catalog-index__select">
          <label for="catalog-chapter">Jump to chapter</label>
          <select id="catalog-chapter">
            <option value="">Choose a chapter</option>
            {
              companion.data.chapters.map((chapter) => (
                <option value={`#chapter-${chapter.number}`}>
                  {chapter.number}. {chapter.title}
                </option>
              ))
            }
          </select>
        </div>
      </aside>

      <div class="prose catalog-body">
        <h2 class="catalog-intro">{companion.data.introTitle}</h2>
        <Content />
      </div>
    </div>
  </article>

  <script>
    function wireCatalogJump() {
      const select = document.querySelector<HTMLSelectElement>("#catalog-chapter");
      if (!select || select.dataset.wired === "true") return;
      select.dataset.wired = "true";
      select.addEventListener("change", () => {
        if (!select.value) return;
        const target = document.querySelector<HTMLElement>(select.value);
        if (!target) return;
        history.pushState(null, "", select.value);
        target.scrollIntoView({ block: "start" });
      });
    }

    wireCatalogJump();
    document.addEventListener("astro:after-swap", wireCatalogJump);
  </script>
</BaseLayout>

<style>
  .catalog {
    padding-block-end: clamp(var(--space-xl), 8vw, var(--space-3xl));
  }

  .catalog-head {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1fr);
    gap: var(--space-m) clamp(var(--space-l), 7vw, var(--space-2xl));
    padding-block: clamp(var(--space-l), 7vw, var(--space-2xl));
    border-bottom: var(--border-hairline);
  }

  .catalog-head__context {
    display: flex;
    gap: var(--space-2xs);
    align-items: baseline;
    min-width: 0;
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .catalog-head__context a:last-child {
    overflow-wrap: anywhere;
  }

  .catalog-head__title h1 {
    max-width: 14ch;
  }

  .catalog-head__details {
    grid-column: 2;
    max-width: 43rem;
  }

  .catalog-head__details > * + * {
    margin-block-start: var(--space-s);
  }

  .catalog-head__explore {
    display: inline-flex;
    margin-inline-start: var(--space-m);
  }

  .catalog-head__counts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .catalog-head__counts span + span::before {
    margin-inline-end: var(--space-m);
    color: var(--color-border);
    content: "·";
  }

  .catalog-layout {
    display: grid;
    grid-template-columns: minmax(11rem, 0.38fr) minmax(0, var(--container-narrow));
    gap: var(--space-l) clamp(var(--space-l), 7vw, var(--space-2xl));
    padding-block-start: clamp(var(--space-xl), 8vw, var(--space-2xl));
  }

  .catalog-index {
    min-width: 0;
  }

  .catalog-index nav {
    position: sticky;
    top: calc(var(--space-xl) + var(--space-s));
    max-height: calc(100vh - var(--space-xl) - 2 * var(--space-s));
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .catalog-index nav > p,
  .catalog-index__select label {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }

  .catalog-index ol {
    margin-block-start: var(--space-s);
    padding: 0;
    list-style: none;
  }

  .catalog-index li + li {
    margin-block-start: var(--space-xs);
  }

  .catalog-index a {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  .catalog-index a span {
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .catalog-index a:hover {
    color: var(--color-text);
  }

  .catalog-index__select {
    display: none;
  }

  .catalog-body {
    min-width: 0;
  }

  .catalog-body :global(h2) {
    scroll-margin-top: calc(var(--space-xl) + var(--space-s));
    margin-block-start: clamp(var(--space-2xl), 10vw, var(--space-3xl));
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
    font-size: var(--step-2);
  }

  .catalog-body .catalog-intro {
    margin-block-start: 0;
    padding-block-start: 0;
    border-top: 0;
  }

  .catalog-body :global(.catalog-group-label) {
    margin-block: var(--space-xl) var(--space-l);
    padding-block: var(--space-s);
    border-block: var(--border-hairline);
    color: var(--color-text-secondary);
    font-weight: var(--weight-semibold);
  }

  .catalog-body :global(.catalog-group-label--taught) {
    background: var(--color-bg-subtle);
  }

  .catalog-body :global(.catalog-practice) {
    scroll-margin-top: calc(var(--space-xl) + var(--space-s));
    max-width: 34ch;
    margin-block-start: var(--space-xl);
    font-size: var(--step-1);
  }

  .catalog-body :global(.catalog-practice:target) {
    color: var(--color-accent);
  }

  .catalog-body :global(.catalog-practice-id) {
    margin-block-start: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .catalog-body :global(.catalog-practice-id a) {
    color: inherit;
    text-decoration: none;
  }

  .catalog-body :global(.catalog-practice-id a:hover) {
    color: var(--color-accent);
  }

  .catalog-body :global(.catalog-practice-id code) {
    padding: 0;
    background: transparent;
  }

  @media (max-width: 52rem) {
    .catalog-head,
    .catalog-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .catalog-head__title,
    .catalog-head__details {
      grid-column: 1;
    }

    .catalog-index nav {
      display: none;
    }

    .catalog-index__select {
      display: grid;
      gap: var(--space-2xs);
    }

    .catalog-index__select select {
      width: 100%;
      min-height: 2.75rem;
      padding-inline: var(--space-xs);
      border: var(--border-hairline);
      border-radius: var(--radius-s);
      background: var(--color-bg);
      color: var(--color-text);
      font: inherit;
    }

    .catalog-head__explore {
      margin-inline-start: 0;
    }
  }

  @media print {
    .catalog-head__context,
    .catalog-head__details a,
    .catalog-index {
      display: none;
    }

    .catalog-head,
    .catalog-layout {
      display: block;
    }

    .catalog-body {
      max-width: none;
    }

    .catalog-body :global(h2) {
      break-before: page;
    }
  }
</style>
