---
import PageLayout from "@/layouts/PageLayout.astro";
import { site, socials, affiliations } from "@/data/site";

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: "AI Engineer",
  description: site.description,
  worksFor: affiliations
    .filter((a) => a.relation === "worksFor")
    .map((a) => ({ "@type": "Organization", name: a.name })),
  affiliation: affiliations
    .filter((a) => a.relation === "affiliation")
    .map((a) => ({ "@type": "Organization", name: a.name })),
  sameAs: socials.filter((s) => s.label !== "Email").map((s) => s.href),
};
---

<PageLayout
  title="About"
  kicker="Hello"
  intro="AI engineer and researcher, illustrator, and mom."
  description="About Stephanie Jarmak."
>
  <div class="prose">
    <p>
      I'm an AI engineer and researcher focused on how people and machines find knowledge. I
      work on reliable AI systems: how models use context, tools, and structured knowledge, and
      how to tell whether the result actually works. I'm an AI Engineer at <strong>Omni</strong>.
      Before that, at <strong>Sourcegraph</strong>, I did applied research on coding agents and
      code intelligence, including benchmarks for how agents perform in large, multi-repo
      codebases. As a research affiliate with
      <strong>NASA's Science Explorer (SciX)</strong>, I continue work on AI-powered scientific
      search: natural language processing, entity extraction, embeddings, and knowledge graphs.
    </p>
    <p>
      My path here ran through planetary science. I earned a Ph.D. studying asteroids with space
      telescopes, planetary rings, and the granular flows that shape them. That work taught me to
      take messy, real-world data seriously, a habit that carries directly into evaluating AI and
      search systems honestly.
    </p>
    <p>
      Away from research, I make music and illustrate children's books. The same curiosity runs
      through all of it: pay attention, find the structure, share what you see.
    </p>

    <h2>Elsewhere</h2>
    <ul>
      {socials.map((s) => (
        <li>
          <a href={s.href} rel="me noopener">{s.label}</a>
        </li>
      ))}
    </ul>
  </div>
</PageLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
