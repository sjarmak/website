---
import PageLayout from "@/layouts/PageLayout.astro";
import { getDigests, getDigestTopics, getPodcasts } from "@/lib/knowledge/build";
import type { DigestIssue, PodcastSeries, PodcastEpisode } from "@/lib/knowledge/types";
import { fullDate } from "@/lib/dates";

const digests: DigestIssue[] = await getDigests();
const topics: string[] = await getDigestTopics();
const { series: podcastSeries, standalone: podcastStandalone } = await getPodcasts();

const CADENCE_LABEL: Record<DigestIssue["cadence"], string> = {
  daily: "Daily",
  weekly: "Weekly",
  monthly: "Monthly",
};

// Two axes the page filters on: who made it, and whether it has a podcast.
function sourceOf(d: DigestIssue): "curated" | "automated" {
  return d.origin === "manual" ? "curated" : "automated";
}
function hasAudio(d: DigestIssue): boolean {
  return Boolean(d.audioUrl || d.embedUrl);
}
function formatOf(d: DigestIssue): "audio" | "newsletter" {
  return hasAudio(d) ? "audio" : "newsletter";
}

function topicLabel(slug: string): string {
  return slug.replace(/-/g, " ");
}

function minutes(sec?: number): string | null {
  if (!sec) return null;
  return `${Math.round(sec / 60)} min`;
}
---

<PageLayout
  title="Digest"
  kicker="Research"
  intro="Issues published from my reading: a written newsletter, and for some, a podcast. Curated issues are ones I hand-pick; automated ones come out of my code-intelligence-digest pipeline. Filter by format, source, or topic."
>
  <div class="stack stack-l">
    <!-- filter bar — two axes: format (audio vs newsletter) and source (curated vs automated) -->
    <form class="digest-filters" id="digest-filters" aria-label="Filter digests">
      <label class="field">
        <span class="field__label">Format</span>
        <select id="f-format">
          <option value="">All formats</option>
          <option value="audio">Audio (podcast)</option>
          <option value="newsletter">Newsletter only</option>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Source</span>
        <select id="f-source">
          <option value="">All sources</option>
          <option value="curated">Curated (hand-picked)</option>
          <option value="automated">Automated</option>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Topic</span>
        <select id="f-topic">
          <option value="">All topics</option>
          {topics.map((t) => <option value={t}>{topicLabel(t)}</option>)}
        </select>
      </label>
      <label class="field field--grow">
        <span class="field__label">Search</span>
        <input type="search" id="f-search" placeholder="title or summary…" />
      </label>
    </form>

    <p class="digest-count muted" id="digest-count">{digests.length} issues</p>

    <ul role="list" class="auto-grid digest-grid" id="digest-grid" style="--grid-min: 20rem; --grid-gap: var(--space-m)">
      {
        digests.map((d) => (
          <li
            class="lib-card digest-card"
            data-source={sourceOf(d)}
            data-format={formatOf(d)}
            data-topics={d.topics.join(" ")}
            data-text={`${d.title} ${d.summary}`.toLowerCase()}
          >
            <div class="digest-card__meta">
              <span class={`badge badge--source-${sourceOf(d)}`}>
                {sourceOf(d) === "curated" ? "Curated" : "Automated"}
              </span>
              <span class={`badge badge--${d.cadence}`}>{CADENCE_LABEL[d.cadence]}</span>
              <span class="muted">{fullDate(d.date)}</span>
              {hasAudio(d) ? (
                <span class="digest-card__pod" title="Includes a podcast episode">
                  🎧 {minutes(d.durationSec) ?? "audio"}
                </span>
              ) : (
                <span class="digest-card__fmt" title="Written newsletter">✉ Newsletter</span>
              )}
            </div>
            <h3 class="lib-card__title">
              <a href={`/digest/${d.slug}`}>{d.title}</a>
            </h3>
            <p class="lib-card__desc">{d.summary}</p>
            {d.topics.length > 0 && (
              <div class="cluster" style="--cluster-gap: var(--space-2xs)">
                {d.topics.map((t) => (
                  <span class="tag">{topicLabel(t)}</span>
                ))}
              </div>
            )}
            <p class="lib-card__count">
              {d.linkCount} {d.linkCount === 1 ? "link" : "links"}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="digest-empty muted" id="digest-empty" hidden>No issues match those filters.</p>

    {
      (podcastSeries.length > 0 || podcastStandalone.length > 0) && (
        <section class="deep-dives">
          <h2 class="sub">Deep-dive series</h2>
          <p class="muted measure" style="margin-block-end: var(--space-m)">
            Longer, hand-made audio: literature-survey episodes that walk a whole theme from the explorers. Listen inline, or download the audio.
          </p>
          <div class="stack stack-l">
            {podcastSeries.map((s: PodcastSeries) => (
              <div>
                <h3 class="pod-series">{s.name}</h3>
                <ul role="list" class="stack">
                  {s.episodes.map((ep: PodcastEpisode) => (
                    <li class="pod-ep">
                      <span class="pod-ep__title">
                        {ep.episode ? `${ep.episode}. ` : ""}
                        {ep.title}
                      </span>
                      <p class="muted">{ep.description}</p>
                      {ep.embedUrl ? (
                        <iframe class="pod-ep__embed" src={ep.embedUrl} loading="lazy" title={ep.title} />
                      ) : (
                        ep.audioUrl && (
                          <audio controls preload="none">
                            <source src={ep.audioUrl} type="audio/mpeg" />
                          </audio>
                        )
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            {podcastStandalone.map((ep: PodcastEpisode) => (
              <div class="pod-ep">
                <span class="pod-ep__title">{ep.title}</span>
                <p class="muted">{ep.description}</p>
                {ep.embedUrl ? (
                  <iframe class="pod-ep__embed" src={ep.embedUrl} loading="lazy" title={ep.title} />
                ) : (
                  ep.audioUrl && (
                    <audio controls preload="none">
                      <source src={ep.audioUrl} type="audio/mpeg" />
                    </audio>
                  )
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    <p class="crosslink muted">
      Issues and audio published from the <a href="/library">research library</a>.{" "}
      <a href="/digest/rss.xml">Subscribe via RSS →</a>
    </p>
  </div>
</PageLayout>

<script>
  const grid = document.getElementById("digest-grid");
  const format = document.getElementById("f-format") as HTMLSelectElement;
  const source = document.getElementById("f-source") as HTMLSelectElement;
  const topic = document.getElementById("f-topic") as HTMLSelectElement;
  const search = document.getElementById("f-search") as HTMLInputElement;
  const count = document.getElementById("digest-count");
  const empty = document.getElementById("digest-empty");

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".digest-card"));

    const apply = () => {
      const fmt = format.value;
      const src = source.value;
      const t = topic.value;
      const q = search.value.trim().toLowerCase();
      let shown = 0;

      for (const card of cards) {
        const topics = (card.dataset.topics ?? "").split(" ");
        const match =
          (!fmt || card.dataset.format === fmt) &&
          (!src || card.dataset.source === src) &&
          (!t || topics.includes(t)) &&
          (!q || (card.dataset.text ?? "").includes(q));
        card.hidden = !match;
        if (match) shown++;
      }

      if (count) count.textContent = `${shown} ${shown === 1 ? "issue" : "issues"}`;
      if (empty) empty.hidden = shown !== 0;
    };

    for (const el of [format, source, topic, search]) {
      el.addEventListener("input", apply);
    }
  }
</script>

<style>
  .digest-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-s) var(--space-m);
    padding: var(--space-m);
    border: var(--border-hairline);
    border-radius: var(--radius-l);
    background: var(--color-bg-subtle);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .field--grow {
    flex: 1 1 12rem;
  }

  .field--check {
    flex-direction: row;
    align-items: center;
    gap: var(--space-xs);
    padding-block-end: var(--space-2xs);
  }

  .field__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-secondary);
  }

  .field select,
  .field input[type="search"] {
    font: inherit;
    font-size: var(--step--1);
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-hairline);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .field input[type="search"] {
    width: 100%;
  }

  .digest-count {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .digest-card {
    gap: var(--space-xs);
  }

  .digest-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .digest-card__pod {
    color: var(--color-accent);
  }

  .digest-card__fmt {
    color: var(--color-text-muted);
  }

  .digest-card .lib-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .digest-card .lib-card__title a:hover {
    color: var(--color-accent);
  }

  .badge {
    display: inline-block;
    padding: 0.1em 0.6em;
    border-radius: var(--radius);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border: var(--border-hairline);
    color: var(--color-text-secondary);
  }

  .badge--daily {
    border-color: color-mix(in oklch, var(--color-accent) 45%, var(--color-border));
    color: var(--color-accent);
  }

  .badge--weekly {
    border-color: color-mix(in oklch, var(--color-accent) 25%, var(--color-border));
  }

  .badge--monthly {
    border-color: color-mix(in oklch, var(--color-accent) 15%, var(--color-border));
  }

  /* source badges — "curated" reads as the deliberate, hand-picked one */
  .badge--source-curated {
    border-color: color-mix(in oklch, var(--color-accent) 55%, var(--color-border));
    color: var(--color-accent);
    background: color-mix(in oklch, var(--color-accent) 10%, transparent);
  }

  .badge--source-automated {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .crosslink {
    font-size: var(--step-0);
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
  }

  .crosslink a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .crosslink a:hover {
    text-decoration: underline;
  }

  /* ---- deep-dive series (literature-survey podcasts) ---- */
  .deep-dives {
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
  }

  .deep-dives .sub {
    font-size: var(--step-2);
    margin-block-end: var(--space-2xs);
  }

  .pod-series {
    font-size: var(--step-1);
    margin-block-end: var(--space-s);
  }

  .pod-ep {
    padding-block: var(--space-s);
    border-bottom: var(--border-hairline);
  }

  .pod-ep__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .pod-ep__embed {
    width: 100%;
    height: 152px;
    border: 0;
    border-radius: var(--radius);
    margin-block-start: var(--space-s);
  }

  .pod-ep audio {
    width: 100%;
    margin-block-start: var(--space-s);
  }
</style>
