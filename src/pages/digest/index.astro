---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import Transcript from "@/components/knowledge/Transcript.astro";
import DigestIssueCard from "@/components/digest/DigestIssueCard.astro";
import { getDigests, getDigestTopics, getPodcasts } from "@/lib/knowledge/build";
import type { DigestIssue, PodcastSeries, PodcastEpisode } from "@/lib/knowledge/types";

const digests: DigestIssue[] = await getDigests();
const topics: string[] = await getDigestTopics();
const { series: podcastSeries, standalone: podcastStandalone } = await getPodcasts();

// Transcripts joined to episodes by audioUrl, so each deep-dive can be read as well as heard.
const transcriptByAudio = new Map((await getCollection("transcripts")).map((t) => [t.data.audioUrl, t] as const));

// Only the last two days of issues render here; the full archive lives at /digest/archive.
const WINDOW_MS = 2 * 24 * 60 * 60 * 1000;
const cutoff = Date.now() - WINDOW_MS;
const recentIssues = digests.filter((d) => d.date.getTime() >= cutoff);

// Conference field notes: essays tagged "field-notes" plus their companion podcast
// episodes (learning entries with hub: field-notes). The hub overview pins first.
const fieldNotePosts = (await getCollection("posts", (p) => !p.data.draft && p.data.tags.includes("field-notes"))).sort(
  (a, b) =>
    (b.id === "wf2026-field-notes" ? 1 : 0) - (a.id === "wf2026-field-notes" ? 1 : 0) ||
    a.data.title.localeCompare(b.data.title),
);
const fieldNoteEpisodes = podcastStandalone.filter((ep) => ep.hub === "field-notes");
const standaloneEpisodes = podcastStandalone.filter((ep) => ep.hub !== "field-notes");

function topicLabel(slug: string): string {
  return slug.replace(/-/g, " ");
}

function anchorOf(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}
---

<PageLayout register="generated"
  title="Digest"
  kicker="Research"
  intro="Issues published from my reading: a written newsletter, and for some, a podcast. Curated issues are ones I hand-pick; automated ones come out of my code-intelligence-digest pipeline. Specialized issues go deep on this site's core topics; general issues round up the highest-signal news across the agentic field. Filter by format, source, track, or topic."
>
  <div class="stack stack-l">
    <p class="colophon-note muted">
      Automated issues are produced daily by a pipeline documented in the <a href="/colophon">colophon</a>. Each
      issue feeds evidence into the <a href="/concepts">concepts registry</a>.
    </p>

    <!-- section nav — everything this page holds, one jump away -->
    <nav class="section-nav" aria-label="Digest sections">
      <a href="#issues">Latest issues</a>
      {fieldNotePosts.length > 0 && <a href="#field-notes">Field notes</a>}
      {(podcastSeries.length > 0 || standaloneEpisodes.length > 0) && <a href="#deep-dives">Literature deep dives</a>}
      {podcastSeries.map((s: PodcastSeries) => (
        <a class="section-nav__series" href={`#${anchorOf(s.name)}`}>
          {s.name}
        </a>
      ))}
      <a href="/digest/archive">Archive →</a>
    </nav>

    <!-- filter bar — two axes: format (audio vs newsletter) and source (curated vs automated) -->
    <form class="digest-filters" id="issues" aria-label="Filter digests">
      <label class="field">
        <span class="field__label">Format</span>
        <select id="f-format">
          <option value="">All formats</option>
          <option value="audio">Audio (podcast)</option>
          <option value="newsletter">Newsletter only</option>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Source</span>
        <select id="f-source">
          <option value="">All sources</option>
          <option value="curated">Curated (hand-picked)</option>
          <option value="automated">Automated</option>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Track</span>
        <select id="f-track">
          <option value="">All tracks</option>
          <option value="specialized">Specialized (core topics)</option>
          <option value="general">General (field roundup)</option>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Topic</span>
        <select id="f-topic">
          <option value="">All topics</option>
          {topics.map((t) => <option value={t}>{topicLabel(t)}</option>)}
        </select>
      </label>
      <label class="field field--grow">
        <span class="field__label">Search</span>
        <input type="search" id="f-search" placeholder="title or summary…" />
      </label>
    </form>

    <p class="digest-count muted">
      <span id="digest-count">{recentIssues.length} issues from the last two days</span>
      {" · "}
      <a href="/digest/archive">browse all {digests.length} in the archive →</a>
    </p>

    <ul role="list" class="auto-grid digest-grid" id="digest-grid" style="--grid-min: 20rem; --grid-gap: var(--space-m)">
      {recentIssues.map((d) => <DigestIssueCard issue={d} />)}
    </ul>

    <p class="digest-empty muted" id="digest-empty" hidden>No issues match those filters.</p>

    {
      (fieldNotePosts.length > 0 || fieldNoteEpisodes.length > 0) && (
        <section class="field-notes" id="field-notes">
          <h2 class="sub">Field notes</h2>
          <p class="muted measure" style="margin-block-end: var(--space-m)">
            Automated conference notes: essays agent-distilled from talk recordings, with a companion podcast episode.
            Names and quotes are approximate where auto-captions garbled them.
          </p>
          <ul role="list" class="stack fn-list">
            {fieldNotePosts.map((p) => (
              <li class="fn-item">
                <a class="fn-item__title" href={`/writing/${p.id}`}>
                  {p.data.title}
                </a>
                <p class="muted">{p.data.description}</p>
              </li>
            ))}
          </ul>
          {fieldNoteEpisodes.map((ep) => {
            const transcript = ep.audioUrl ? transcriptByAudio.get(ep.audioUrl) : undefined;
            return (
              <div class="pod-ep">
                <span class="pod-ep__title">{ep.title}</span>
                <p class="muted">{ep.description}</p>
                {ep.audioUrl && (
                  <audio controls preload="none">
                    <source src={ep.audioUrl} type="audio/mpeg" />
                  </audio>
                )}
                {transcript && <Transcript entry={transcript} />}
              </div>
            );
          })}
        </section>
      )
    }

    {
      (podcastSeries.length > 0 || standaloneEpisodes.length > 0) && (
        <section class="deep-dives" id="deep-dives">
          <h2 class="sub">Deep-dive series</h2>
          <p class="muted measure" style="margin-block-end: var(--space-m)">
            Literature-survey episodes that walk a whole theme from the explorers. Listen inline, or download the audio.
          </p>
          <div class="stack stack-l">
            {podcastSeries.map((s: PodcastSeries) => (
              <div class="pod-series-block" id={anchorOf(s.name)}>
                <h3 class="pod-series">{s.name}</h3>
                <ul role="list" class="stack">
                  {s.episodes.map((ep: PodcastEpisode) => {
                    const transcript = ep.audioUrl ? transcriptByAudio.get(ep.audioUrl) : undefined;
                    return (
                      <li class="pod-ep">
                        <span class="pod-ep__title">
                          {ep.episode ? `${ep.episode}. ` : ""}
                          {ep.title}
                        </span>
                        <p class="muted">{ep.description}</p>
                        {ep.embedUrl ? (
                          <iframe class="pod-ep__embed" src={ep.embedUrl} loading="lazy" title={ep.title} />
                        ) : (
                          ep.audioUrl && (
                            <audio controls preload="none">
                              <source src={ep.audioUrl} type="audio/mpeg" />
                            </audio>
                          )
                        )}
                        {transcript && <Transcript entry={transcript} />}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
            {standaloneEpisodes.map((ep: PodcastEpisode) => {
              const transcript = ep.audioUrl ? transcriptByAudio.get(ep.audioUrl) : undefined;
              return (
                <div class="pod-ep">
                  <span class="pod-ep__title">{ep.title}</span>
                  <p class="muted">{ep.description}</p>
                  {ep.embedUrl ? (
                    <iframe class="pod-ep__embed" src={ep.embedUrl} loading="lazy" title={ep.title} />
                  ) : (
                    ep.audioUrl && (
                      <audio controls preload="none">
                        <source src={ep.audioUrl} type="audio/mpeg" />
                      </audio>
                    )
                  )}
                  {transcript && <Transcript entry={transcript} />}
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    <p class="crosslink muted">
      Issues and audio published from the <a href="/library">research library</a>.{" "}
      <a href="/digest/rss.xml">Subscribe via RSS →</a>
    </p>
  </div>
</PageLayout>

<script>
  const grid = document.getElementById("digest-grid");
  const format = document.getElementById("f-format") as HTMLSelectElement;
  const source = document.getElementById("f-source") as HTMLSelectElement;
  const track = document.getElementById("f-track") as HTMLSelectElement;
  const topic = document.getElementById("f-topic") as HTMLSelectElement;
  const search = document.getElementById("f-search") as HTMLInputElement;
  const count = document.getElementById("digest-count");
  const empty = document.getElementById("digest-empty");

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".digest-card"));

    const apply = () => {
      const fmt = format.value;
      const src = source.value;
      const trk = track.value;
      const t = topic.value;
      const q = search.value.trim().toLowerCase();
      let shown = 0;

      for (const card of cards) {
        const topics = (card.dataset.topics ?? "").split(" ");
        const match =
          (!fmt || card.dataset.format === fmt) &&
          (!src || card.dataset.source === src) &&
          (!trk || card.dataset.track === trk) &&
          (!t || topics.includes(t)) &&
          (!q || (card.dataset.text ?? "").includes(q));
        card.hidden = !match;
        if (match) shown++;
      }

      if (count) count.textContent = `${shown} ${shown === 1 ? "issue" : "issues"}`;
      if (empty) empty.hidden = shown !== 0;
    };

    for (const el of [format, source, track, topic, search]) {
      el.addEventListener("input", apply);
    }
  }
</script>

<style>
  .colophon-note {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .colophon-note a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .colophon-note a:hover {
    text-decoration: underline;
  }

  /* ---- section nav (top-of-page discovery) ---- */
  .section-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .section-nav a {
    display: inline-block;
    padding: 0.25em 0.8em;
    border: var(--border-hairline);
    border-radius: 999px;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      color 0.12s ease,
      border-color 0.12s ease;
  }

  .section-nav a:hover {
    color: var(--color-accent);
    border-color: color-mix(in oklch, var(--color-accent) 45%, var(--color-border));
  }

  .section-nav__series {
    font-size: var(--step--2);
  }

  #issues,
  #field-notes,
  #deep-dives,
  .pod-series-block {
    scroll-margin-block-start: var(--space-l);
  }

  .digest-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-s) var(--space-m);
    padding: var(--space-m);
    border: var(--border-hairline);
    border-radius: var(--radius-l);
    background: var(--color-bg-subtle);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .field--grow {
    flex: 1 1 12rem;
  }

  .field--check {
    flex-direction: row;
    align-items: center;
    gap: var(--space-xs);
    padding-block-end: var(--space-2xs);
  }

  .field__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-secondary);
  }

  .field select,
  .field input[type="search"] {
    font: inherit;
    font-size: var(--step--1);
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-hairline);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .field input[type="search"] {
    width: 100%;
  }

  .digest-count {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .digest-count a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .digest-count a:hover {
    text-decoration: underline;
  }

  /* ---- field notes (conference-notes hub) ---- */
  .field-notes {
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
  }

  .field-notes .sub {
    font-size: var(--step-2);
    margin-block-end: var(--space-2xs);
  }

  .fn-item {
    padding-block: var(--space-xs);
    border-bottom: var(--border-hairline);
  }

  .fn-item__title {
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: inherit;
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .fn-item__title:hover {
    color: var(--color-accent);
  }

  .field-notes .pod-ep {
    border-bottom: 0;
  }

  .crosslink {
    font-size: var(--step-0);
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
  }

  .crosslink a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .crosslink a:hover {
    text-decoration: underline;
  }

  /* ---- deep-dive series (literature-survey podcasts) ---- */
  .deep-dives {
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
  }

  .deep-dives .sub {
    font-size: var(--step-2);
    margin-block-end: var(--space-2xs);
  }

  .pod-series {
    font-size: var(--step-1);
    margin-block-end: var(--space-s);
  }

  .pod-ep {
    padding-block: var(--space-s);
    border-bottom: var(--border-hairline);
  }

  .pod-ep__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .pod-ep__embed {
    width: 100%;
    height: 152px;
    border: 0;
    border-radius: var(--radius);
    margin-block-start: var(--space-s);
  }

  .pod-ep audio {
    width: 100%;
    margin-block-start: var(--space-s);
  }
</style>
