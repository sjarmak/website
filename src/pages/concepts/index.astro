---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import { site } from "@/data/site";
import { isIndexableConcept } from "@/lib/concepts/indexState";
import { REGISTER_COPY } from "@/lib/registerCopy";

const entries = await getCollection("concepts");
const concepts = entries
  .map((entry) => ({
    slug: entry.id,
    label: entry.data.label,
    definition: entry.data.definition,
    indexable: isIndexableConcept(entry.id),
  }))
  .sort((a, b) => a.label.localeCompare(b.label));

const stamp = REGISTER_COPY.reference;

// The DefinedTermSet is emitted ONCE, here, at its stable URL (PRD R4′);
// every indexable concept page's DefinedTerm references this @id.
const termSetId = `${site.url}/concepts/#definedtermset`;
const definedTermSetLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": termSetId,
  name: "Concepts — sjarmak.ai",
  description:
    "The canonical concept vocabulary behind the sjarmak.ai knowledge graph: agentic coding, evaluation, retrieval, and the systems around them.",
  url: `${site.url}/concepts/`,
  hasDefinedTerm: concepts
    .filter((c) => c.indexable)
    .map((c) => ({
      "@type": "DefinedTerm",
      "@id": `${site.url}/concepts/${c.slug}/#term`,
      name: c.label,
    })),
};
---

<PageLayout
  register="reference"
  title="Concepts"
  kicker="Reference"
  intro="The canonical concept vocabulary behind the knowledge graph — each concept with its definition and the dated evidence (digest issues, papers, explorer sections) behind it."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(definedTermSetLd)} />
  </Fragment>

  <ul role="list" class="concept-list stack stack-l">
    {
      concepts.map((c) => (
        <li class="concept-list__item">
          <h2 class="concept-list__label">
            <a href={`/concepts/${c.slug}/`}>{c.label}</a>
          </h2>
          <p class="muted measure">{c.definition}</p>
        </li>
      ))
    }
  </ul>

  <p class="concept-map-link">
    <a href="/prototypes/concepts">Explore the concept map →</a>
  </p>

  <footer class="concept-stamp muted">
    <span class="concept-stamp__label">{stamp.label}</span> · {stamp.badgeCopy}
  </footer>
</PageLayout>

<style>
  .concept-list__label {
    font-size: var(--step-1);
  }
  .concept-map-link {
    margin-block-start: var(--space-xl);
  }
  .concept-stamp {
    margin-block: var(--space-xl) var(--space-l);
    padding-block-start: var(--space-s);
    border-block-start: var(--border-hairline);
    font-size: var(--step--1);
  }
  .concept-stamp__label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
</style>
