---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { buildConceptGraph, loadTopicMeta } from "@/lib/graph/buildConceptGraph";
import { loadDigestDocs } from "@/lib/knowledge/conceptMembership";
import { computeConceptFreshness } from "@/lib/knowledge/conceptFreshness";
import { buildConceptPanel, type ConceptPanel } from "@/scripts/concept-panel";
import { isIndexableConcept } from "@/lib/concepts/indexState";
import { REGISTER_COPY } from "@/lib/registerCopy";

export async function getStaticPaths() {
  // Cap on the related-concepts list: all frontmatter `related` entries,
  // topped up with the strongest co-occurrence partners.
  const RELATED_CAP = 6;
  const entries = await getCollection("concepts");
  const graph = buildConceptGraph();
  const topics = loadTopicMeta();
  const totalDigests = loadDigestDocs().length;

  const nodeBySlug = new Map(
    graph.nodes.filter((n) => n.type === "concept").map((n) => [n.id, n]),
  );
  const labelBySlug = new Map(entries.map((e) => [e.id, e.data.label]));

  return entries.map((entry) => {
    const node = nodeBySlug.get(entry.id);
    if (node === undefined || node.evidence === undefined) {
      throw new Error(`concepts/${entry.id}: missing from the concept graph`);
    }
    const panel = buildConceptPanel(node, computeConceptFreshness(node.evidence.digests, totalDigests));

    // Related concepts: curated `related` references first, then the top
    // co-occurrence partners from the FULL weighted edge list (PRD R4′).
    const relatedSlugs = entry.data.related.map((ref) => ref.id);
    const partners = graph.conceptEdges
      .filter((e) => e.source === entry.id || e.target === entry.id)
      .map((e) => (e.source === entry.id ? e.target : e.source));
    const merged = [...relatedSlugs];
    for (const partner of partners) {
      if (merged.length >= RELATED_CAP) break;
      if (partner !== entry.id && !merged.includes(partner)) merged.push(partner);
    }
    const related = merged.slice(0, RELATED_CAP).map((slug) => {
      const label = labelBySlug.get(slug);
      if (label === undefined) {
        throw new Error(`concepts/${entry.id}: related concept "${slug}" is not in the registry`);
      }
      return { slug, label };
    });

    const topicId = entry.data.topic?.id;
    const topic =
      topicId !== undefined ? { id: topicId, title: topics.get(topicId)?.title ?? topicId } : null;

    return { params: { slug: entry.id }, props: { entry, panel, related, topic } };
  });
}

interface RelatedConcept {
  slug: string;
  label: string;
}

interface Props {
  entry: CollectionEntry<"concepts">;
  panel: ConceptPanel;
  related: RelatedConcept[];
  topic: { id: string; title: string } | null;
}

const { entry, panel, related, topic } = Astro.props;
const { label, definition, aliases } = entry.data;
const slug = entry.id;

// Committed index state (PRD R4′): allowlist OR human-approved authored body.
// Evidence data plays no part — a build can never flip this, only a commit.
const indexable = isIndexableConcept(slug);

const hasBody = typeof entry.body === "string" && entry.body.trim().length > 0;
const { Content } = await render(entry);

const stamp = REGISTER_COPY.reference;

// JSON-LD (indexable pages ONLY): DefinedTerm referencing the DefinedTermSet
// emitted once at /concepts/ (its stable URL), plus BreadcrumbList.
const pageUrl = `${site.url}/concepts/${slug}/`;
const termSetId = `${site.url}/concepts/#definedtermset`;
const definedTermLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "@id": `${pageUrl}#term`,
  name: label,
  description: definition,
  ...(aliases.length > 0 ? { alternateName: aliases } : {}),
  url: pageUrl,
  inDefinedTermSet: { "@id": termSetId },
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
    { "@type": "ListItem", position: 2, name: "Concepts", item: `${site.url}/concepts/` },
    { "@type": "ListItem", position: 3, name: label, item: pageUrl },
  ],
};
---

<BaseLayout register="reference" title={label} description={definition} noindex={!indexable}>
  <Fragment slot="head">
    {indexable && <script type="application/ld+json" is:inline set:html={JSON.stringify(definedTermLd)} />}
    {indexable && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />}
  </Fragment>
  <article class="container container-narrow concept-page">
    <nav class="breadcrumb muted" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/concepts/">Concepts</a>
      {
        topic && (
          <>
            <span aria-hidden="true">›</span>
            <a href={`/prototypes/concepts?node=topic:${topic.id}`}>{topic.title}</a>
          </>
        )
      }
      <span aria-hidden="true">›</span>
      <span aria-current="page">{label}</span>
    </nav>

    <header class="concept-page__head stack stack-s">
      <h1>{label}</h1>
    </header>

    <p class="concept-page__definition lead measure">{definition}</p>

    {
      aliases.length > 0 && (
        <p class="concept-page__aliases muted">Also known as: {aliases.join(", ")}</p>
      )
    }

    {
      hasBody && (
        <div class="prose concept-page__body">
          <Content />
        </div>
      )
    }

    {panel.freshnessLine && <p class="concept-page__freshness muted">{panel.freshnessLine}</p>}

    {
      panel.groups.map((group) => (
        <section class="concept-page__evidence">
          <h2>{group.heading}</h2>
          <ul role="list" class="stack stack-s">
            {group.items.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} rel={item.href.startsWith("http") ? "noopener" : undefined}>
                    {item.label}
                  </a>
                ) : (
                  <span data-node-type={item.type}>{item.label}</span>
                )}
                {item.meta && <span class="muted"> — {item.meta}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      related.length > 0 && (
        <section class="concept-page__related">
          <h2>Related concepts</h2>
          <ul role="list" class="cluster">
            {related.map((r) => (
              <li>
                <a href={`/concepts/${r.slug}/`}>{r.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="concept-page__map-link">
      <a href={`/prototypes/concepts?node=concept:${slug}`}>Explore in the concept map →</a>
    </p>

    <footer class="concept-page__stamp muted">
      <span class="concept-page__stamp-label">{stamp.label}</span> · {stamp.badgeCopy}
    </footer>
  </article>
</BaseLayout>

<style>
  .concept-page {
    padding-block: clamp(var(--space-l), 6vw, var(--space-2xl));
  }
  .breadcrumb {
    font-size: var(--step--1);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .concept-page__head {
    margin-block: var(--space-m) var(--space-s);
  }
  .concept-page__aliases {
    font-size: var(--step--1);
    margin-block-start: var(--space-2xs);
  }
  .concept-page__body {
    margin-block: var(--space-l);
  }
  .concept-page__freshness {
    font-size: var(--step--1);
    margin-block-start: var(--space-m);
  }
  .concept-page__evidence,
  .concept-page__related {
    margin-block-start: var(--space-l);
  }
  .concept-page__evidence h2,
  .concept-page__related h2 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-block-end: var(--space-xs);
  }
  .concept-page__map-link {
    margin-block-start: var(--space-l);
  }
  .concept-page__stamp {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-s);
    border-block-start: var(--border-hairline);
    font-size: var(--step--1);
  }
  .concept-page__stamp-label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
</style>
