---
import PageLayout from "@/layouts/PageLayout.astro";
import EmptyState from "@/components/primitives/EmptyState.astro";
import { getWriting, getPublications } from "@/lib/collections";
import { fullDate } from "@/lib/dates";

const writing = await getWriting();
const publications = await getPublications();

type Entry = (typeof writing)[number];

const sourceLabel: Record<string, string> = {
  medium: "Medium",
  sourcegraph: "Sourcegraph",
  ebook: "Ebook",
  book: "Book",
  "on-site": "Essay",
  external: "External",
};

const pubTypeLabel: Record<string, string> = {
  journal: "Paper",
  conference: "Paper",
  preprint: "Preprint",
  thesis: "Thesis",
  abstract: "Abstract",
  software: "Software",
};

const hrefFor = (w: Entry) =>
  w.data.source === "on-site" && w.data.post
    ? `/writing/${w.data.post.id}`
    : w.data.source === "book" && w.data.book
      ? `/books/${w.data.book.id}`
      : (w.data.url ?? "#");

// Grouped, in reading order. getWriting() already sorts newest-first within each source.
const groups: { heading: string; sources: Entry["data"]["source"][] }[] = [
  { heading: "Essays", sources: ["medium", "on-site"] },
  { heading: "Engineering blog", sources: ["sourcegraph"] },
  { heading: "Guides & ebooks", sources: ["book", "ebook"] },
  { heading: "Elsewhere", sources: ["external"] },
];

const sections = groups
  .map((g) => ({
    heading: g.heading,
    entries: writing.filter((w) => g.sources.includes(w.data.source)),
  }))
  .filter((s) => s.entries.length > 0);
---

<PageLayout
  title="Writing"
  kicker="Words"
  intro="Essays, posts, and peer-reviewed papers on agents, retrieval, and planetary science, gathered from Medium, the Sourcegraph blog, journals, and here."
  description="Writing by Stephanie Jarmak on AI agents, retrieval, and scientific search."
>
  {
    writing.length === 0 ? (
      <EmptyState
        title="The index is being assembled"
        note="Posts from Medium and the Sourcegraph blog will be curated here. In the meantime:"
      >
        <p class="cluster" style="--cluster-gap: var(--space-m); justify-content: center">
          <a href="https://medium.com/@steph.jarmak" rel="noopener">Medium ↗</a>
          <a href="https://sourcegraph.com/blog" rel="noopener">Sourcegraph blog ↗</a>
        </p>
      </EmptyState>
    ) : (
      <div class="stack stack-l">
        {sections.map((section) => (
          <section>
            <h2 class="section__heading">{section.heading}</h2>
            <ul role="list" class="stack">
              {section.entries.map((w) => (
                <li class="row">
                  <a class="row__title" href={hrefFor(w)} rel="noopener">
                    {w.data.title}
                  </a>
                  <p class="muted row__desc">{w.data.description}</p>
                  <span class="row__meta muted">
                    {w.data.kind === "technical-report" ? "Technical report" : sourceLabel[w.data.source]}
                    {w.data.date && ` · ${fullDate(w.data.date)}`}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}

        {publications.length > 0 && (
          <section>
            <div class="sub-head">
              <h2 class="section__heading section__heading--flush">Papers</h2>
              <a class="sub-head__more muted" href="/research">All research &amp; press →</a>
            </div>
            <ul role="list" class="stack">
              {publications.map((p) => (
                <li class="row">
                  {p.data.url ? (
                    <a class="row__title" href={p.data.url} rel="noopener">
                      {p.data.title}
                    </a>
                  ) : (
                    <span class="row__title">{p.data.title}</span>
                  )}
                  <p class="muted row__desc">
                    {p.data.authorString ?? p.data.authors.join(", ")}
                    {p.data.venue ? ` · ${p.data.venue}` : ""}
                  </p>
                  <span class="row__meta muted">
                    {pubTypeLabel[p.data.type] ?? "Paper"} · {p.data.year}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )
  }
</PageLayout>

<style>
  .section__heading {
    font-size: var(--step-1);
    padding-block-end: var(--space-s);
    border-bottom: var(--border-hairline);
    margin-block-end: var(--space-s);
  }
  .sub-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding-block-end: var(--space-s);
    border-bottom: var(--border-hairline);
    margin-block-end: var(--space-s);
  }
  .section__heading--flush {
    padding-block-end: 0;
    border-bottom: 0;
    margin-block-end: 0;
  }
  .sub-head__more {
    font-size: var(--step--1);
    white-space: nowrap;
    text-decoration: none;
  }
  .sub-head__more:hover {
    color: var(--color-accent);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3xs) var(--space-m);
    padding-block: var(--space-m);
    border-bottom: var(--border-hairline);
  }
  .row__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-decoration: none;
    color: var(--color-text);
  }
  .row__title:hover {
    color: var(--color-accent);
  }
  .row__desc {
    grid-column: 1;
    max-width: var(--measure);
  }
  .row__meta {
    grid-row: 1;
    grid-column: 2;
    font-size: var(--step--1);
    white-space: nowrap;
    text-align: right;
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 1fr;
    }
    .row__meta {
      grid-row: auto;
      grid-column: 1;
      text-align: left;
    }
  }
</style>
