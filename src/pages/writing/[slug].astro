---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RelatedBlock from "@/components/RelatedBlock.astro";
import { monthYear } from "@/lib/dates";
import { loadRelatedDocs, relatedItems, resolveConcepts } from "@/lib/knowledge/relatedContent";

export async function getStaticPaths() {
  const posts = await getCollection("posts", (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

// Field-notes posts live on the digest page, not the writing index.
const isFieldNotes = data.tags.includes("field-notes");

// R5: related block derived from tag->concept alias resolution.
const concepts = resolveConcepts(data.tags);
const related = relatedItems(concepts, loadRelatedDocs(), { kind: "essay", id: post.id });
---

<BaseLayout register={data.register} title={data.title} description={data.description} type="article">
  <article class="container container-narrow post">
    <header class="post__head stack stack-s">
      <p class="kicker">{isFieldNotes ? "Field notes" : "Essay"}</p>
      <h1>{data.title}</h1>
      <p class="muted">
        {monthYear(data.date)}
        {data.updated ? ` · updated ${monthYear(data.updated)}` : ""}
      </p>
    </header>
    <div class="prose post__body">
      <Content />
    </div>
    <RelatedBlock concepts={concepts} items={related} />
    <p class="post__back">
      {isFieldNotes ? <a href="/digest#field-notes">← Field notes on the digest</a> : <a href="/writing">← All writing</a>}
    </p>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: clamp(var(--space-l), 6vw, var(--space-2xl));
  }
  .post__body {
    margin-block: var(--space-l);
  }
  .post__back {
    margin-block-start: var(--space-xl);
  }
</style>
