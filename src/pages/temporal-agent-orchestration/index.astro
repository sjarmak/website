    max-width: var(--measure);
    margin: 0;
    border-block: var(--border-hairline);
  }

  .tco__ledger > div {
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) 1fr;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-block-end: var(--border-hairline);
  }

  .tco__ledger > div:last-child {
    border-block-end: 0;
  }

