---
import Article from "@/components/temporal-agent-orchestration/Article.mdx";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="I put Temporal around my coding agents"
  description="A firsthand account of Beads, Gas City, orchestration failures, and a production durability experiment with Temporal."
  type="article"
  noindex={true}
>
  <article class="container temporal-agent-article">
    <div class="prose temporal-agent-article__body">
      <Article />
    </div>
  </article>
</BaseLayout>

<style>
  .temporal-agent-article {
    width: min(100% - 2 * var(--space-m), 78rem);
    padding-block: clamp(var(--space-l), 5vw, var(--space-2xl)) var(--space-3xl);
  }

  .temporal-agent-article__body {
    max-width: none;
  }

  :global(.temporal-agent-article__body > :not(.concept-figure, .opening-figure, .code-excerpt, .cast-player)) {
    max-width: var(--measure);
    margin-inline: auto;
  }

  :global(.temporal-agent-article__body > h1) {
    max-width: 17ch;
    margin-block: 0 var(--space-s);
    font-size: var(--step-5);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  :global(.temporal-agent-article__body > h1 + p) {
    margin-block: 0 clamp(var(--space-l), 5vw, var(--space-2xl));
    color: var(--color-text-secondary);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
  }

  :global(.temporal-agent-article__body > h2) {
    margin-block-start: clamp(var(--space-xl), 7vw, var(--space-3xl));
  }

  :global(.temporal-agent-article__body > pre) {
    width: min(100%, 68rem);
    max-width: none;
    margin-block: var(--space-l);
    padding: var(--space-m);
    overflow-x: auto;
    border: 1px solid var(--night-700);
    border-radius: var(--radius);
    background: var(--night-900);
    color: var(--night-100);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* The standfirst under the deck and the ownership pull quote share this
     treatment: a rule in the margin, no plate, no italics. */
  :global(.temporal-agent-article__body > blockquote) {
    margin-block: var(--space-l);
    padding-inline-start: var(--space-m);
    border-inline-start: 2px solid var(--color-accent);
    color: var(--color-text-secondary);
  }

  :global(.temporal-agent-article__body > blockquote > :last-child) {
    margin-block-end: 0;
  }

  /* Tables carry Go test identifiers up to 73 characters with no break
     opportunity inside them. An earlier revision made the table its own
     scroll container, which turned that into a horizontal scrollbar and hid
     the right-hand column until the reader dragged it.

     Fixed layout binds the columns to the container instead of to the
     content, and overflow-wrap lets a long identifier break rather than
     push. The identifiers stay fully readable; they just wrap. */
  :global(.temporal-agent-article__body > table) {
    width: 100%;
    table-layout: fixed;
    border: var(--border-hairline);
    border-collapse: collapse;
    font-size: var(--step--1);
    line-height: 1.45;
  }

  :global(.temporal-agent-article__body > table th:first-child),
  :global(.temporal-agent-article__body > table td:first-child) {
    width: 30%;
  }

  /* Prose cells break words only as a last resort, and with a hyphen; the
     bare `anywhere` this used to share with code broke ordinary words at
     arbitrary characters on narrow phone columns. */
  :global(.temporal-agent-article__body > table th),
  :global(.temporal-agent-article__body > table td) {
    padding: var(--space-xs) var(--space-s);
    border: var(--border-hairline);
    text-align: start;
    vertical-align: top;
    overflow-wrap: break-word;
    hyphens: auto;
    -webkit-hyphenate-limit-before: 4;
    -webkit-hyphenate-limit-after: 4;
    hyphenate-limit-chars: 10 4 4;
  }

  /* The rule that actually does the work: without it the inline code element
     keeps its own intrinsic width and the cell setting is moot.
     box-decoration-break gives each wrapped fragment its own padding and
     rounded ends, instead of one box sliced raggedly across the line break. */
  :global(.temporal-agent-article__body > table code) {
    overflow-wrap: anywhere;
    hyphens: none;
    white-space: normal;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  :global(.temporal-agent-article__body > table th) {
    background: var(--color-bg-subtle);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }

  @media (max-width: 720px) {
    .temporal-agent-article {
      width: min(100% - 2 * var(--space-s), 78rem);
    }

    :global(.temporal-agent-article__body > h1) {
      max-width: none;
    }

    /* Narrow columns cannot spare two space-s gutters per cell, and the
       mono header terms need the smaller step to fit without breaking. */
    :global(.temporal-agent-article__body > table th),
    :global(.temporal-agent-article__body > table td) {
      padding: var(--space-2xs) var(--space-xs);
    }

    :global(.temporal-agent-article__body > table th) {
      padding-inline: var(--space-2xs);
      font-size: var(--step--2);
    }

    /* The three-column comparison table is the tightest fit: shrink its
       short-label first column so the two term columns can hold their
       header words whole. */
    /* At phone widths this table cannot hold its two mono header terms
       whole (the terms alone outrun the columns), so the soft hyphens in
       the header carry one deliberate break and everything else fits:
       23% holds the widest row label, and 3xs gutters give the term
       columns enough room for every word except the one that hyphenates. */
    :global(.temporal-agent-article__body > table:has(th:nth-child(3)) th:first-child),
    :global(.temporal-agent-article__body > table:has(th:nth-child(3)) td:first-child) {
      width: 23%;
    }

    :global(.temporal-agent-article__body > table:has(th:nth-child(3)) th),
    :global(.temporal-agent-article__body > table:has(th:nth-child(3)) td) {
      padding-inline: var(--space-3xs);
    }
  }

  /* The narrowest phones squeeze the label column below its longest word;
     the smaller step plus a slightly wider column keeps the labels whole. */
  @media (max-width: 360px) {
    /* Fixed layout reads column widths from the header row, so the th
       must carry the width even though only the td text needs the room. */
    :global(.temporal-agent-article__body > table:has(th:nth-child(3)) th:first-child),
    :global(.temporal-agent-article__body > table:has(th:nth-child(3)) td:first-child) {
      width: 27%;
    }

    :global(.temporal-agent-article__body > table:has(th:nth-child(3)) td:first-child) {
      font-size: var(--step--2);
    }

    /* The term columns lose ~30px to the wider label column here; one
       notch below the smallest step (which bottoms out at 0.83rem) keeps
       every header word inside its soft-hyphen points instead of
       bare-breaking. */
    :global(.temporal-agent-article__body > table:has(th:nth-child(3)) th) {
      font-size: 0.73rem;
    }
  }
</style>
