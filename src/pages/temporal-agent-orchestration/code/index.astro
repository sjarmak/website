---
import TermTip from "@/components/temporal-agent-orchestration/TermTip.astro";
import {
  preTemporalAgentOrchestrationCodeSamples,
  temporalAgentOrchestrationCodeSamples,
} from "@/data/temporal-agent-orchestration-code-samples";
import PageLayout from "@/layouts/PageLayout.astro";

const root = "/temporal-agent-orchestration";
const samples = [
  ...preTemporalAgentOrchestrationCodeSamples.map((sample) => ({
    ...sample,
    side: "Before Temporal",
  })),
  ...temporalAgentOrchestrationCodeSamples.map((sample) => ({
    ...sample,
    side: "After Temporal",
  })),
];
---

<PageLayout
  title="Complete annotated source"
  kicker="Temporal case study · Code"
  intro="Eight annotated files show the pre-Temporal controller and recovery path, and the Workflow, Activity, bridge, and Worker code that replaced them, with the complete test matrix beneath."
  description="The complete before and after source for a coding-agent orchestration boundary rebuilt with Temporal's Go SDK."
  noindex={true}
>
  <article class="code-index">
    <nav class="code-index__tabs" aria-label="Case study materials">
      <a href={`${root}/code`} aria-current="page">Code</a>
      <a href={`${root}/article`}>Article</a>
    </nav>

    <div class="code-index__guide">
      <p>
        Each reader renders the complete source with IDE-style syntax colors.
        Select a line section to open its explanation directly beneath the
        code, or download the raw file from the reader. The before excerpts
        cite and link the exact public upstream revision they abridge.
      </p>
    </div>

    <ol class="code-index__files">
      {
        samples.map((sample, index) => (
          <li>
            <div class="code-index__number">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div>
              <p class="kicker">{sample.side}</p>
              <h2>{sample.filename}</h2>
              <p>{sample.summary}</p>
            </div>
            <a href={`${root}/code/${sample.slug}`}>
              Open annotated source <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>

    <section class="code-index__tests" aria-labelledby="test-matrix-title">
      <h2 id="test-matrix-title">The full test matrix</h2>
      <div class="code-index__guide">
        <p>
          The suite runs with one command: <code>cd
          services/temporal-maintenance &amp;&amp; go test -race ./...</code>.
          The package that implements the
          Temporal and Beads boundary carries 18 Go test files. Every case
          below runs unconditionally; a small number of heavier integration
          tests require a local Temporal development server and skip
          themselves when the Temporal CLI is not available. The article
          names five invariants; the table holds those down and adds the
          Continue-As-New boundary. The named cases are here.
        </p>
      </div>
      <table class="code-index__matrix">
        <thead>
          <tr>
            <th scope="col">What has to hold</th>
            <th scope="col">Where it is asserted</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Workflow behavior</td>
            <td>
              <code>workflow_test.go</code>: cases covering duplicate ready
              delivery, malformed events, event-limit rejection, and seal
              enforcement
            </td>
          </tr>
          <tr>
            <td>Activity behavior</td>
            <td>
              <code>activity_test.go</code>: cases covering fenced claims,
              heartbeating, stale-generation rejection, and artifact bounds
            </td>
          </tr>
          <tr>
            <td>A duplicate Signal schedules only one Activity</td>
            <td>
              <TermTip
                term="test-duplicate-ready"
                tip="Delivers the same ready event twice and requires the Workflow to schedule the agent Activity once. Redelivery is expected on this path, so it has to be harmless."
              >TestWorkflowDuplicateReadyDeliverySchedulesOneActivity</TermTip>
              <br />
              <TermTip
                term="test-dedup-ready-signal"
                tip="The same property on the delivery side: a repeated OutcomeReady signal must not open a second delivery loop for one result."
              >TestCoordinatorOutcomeWorkflowDeduplicatesReadySignal</TermTip>
            </td>
          </tr>
          <tr>
            <td>A stale acknowledgement fails closed</td>
            <td>
              <TermTip
                term="test-ack-fails-closed"
                tip="An acknowledgement that no longer matches the current store, work item, outcome, generation, and session is refused rather than accepted."
              >TestCoordinatorOutcomeActivityFailsClosedAtAcknowledgementBoundary</TermTip>
              <br />
              <TermTip
                term="test-stale-completion"
                tip="Cancels an Activity that already has an agent attached, then has that agent present a stale claim token. One terminal receipt is written and the stale completion fails closed."
              >TestActivityCancellationReachesAttachedSessionAndStaleCompletionFails</TermTip>
            </td>
          </tr>
          <tr>
            <td>Cancellation reaches the agent without leaving the Workflow hanging</td>
            <td>
              <TermTip
                term="test-cancel-no-hang"
                tip="Cancellation while the agent is still stopping. The Workflow has to finish rather than wait on a process that is on its way out."
              >TestWorkflowCancellationDoesNotHangWhileActivityStops</TermTip>
              <br />
              <TermTip
                term="test-cancel-before-checkpoint"
                tip="The harder arm: nothing has been checkpointed yet, so the Activity has to ask the resolver which session it owns instead of reading heartbeat details."
              >TestActivityCancellationBeforeFirstCheckpointUsesResolvedSession</TermTip>
            </td>
          </tr>
          <tr>
            <td>Continue-As-New preserves state and receipts</td>
            <td>
              <TermTip
                term="test-can-state"
                tip="Continue-As-New starts a fresh Event History for a long-running Workflow. Redelivery state and counters have to cross that boundary intact."
              >TestCoordinatorOutcomeWorkflowContinuesAsNewWithStateAndCounters</TermTip>
              <br />
              <TermTip
                term="test-ack-boundary"
                tip="The failure that boundary invites: an acknowledgement arriving exactly as the history rolls over must not be dropped."
              >TestCoordinatorOutcomeWorkflowDoesNotLoseAcknowledgementAtHistoryBoundary</TermTip>
            </td>
          </tr>
          <tr>
            <td>Captured histories still replay, and incompatible code fails the gate</td>
            <td>
              <TermTip
                term="test-replay-persisted"
                tip="Runs current Workflow code against captured histories and requires the same decisions. This is the check that catches a nondeterministic change before it ships."
              >TestReplayPersistedWorkflowHistory</TermTip>
              {" "}and{" "}
              <TermTip
                term="test-replay-rejects"
                tip="The negative case. A deliberately nondeterministic Workflow is planted and replay must reject it, which is what proves the gate is wired up at all."
              >TestReplayRejectsPlantedNondeterministicWorkflow</TermTip>
              {" "}in <code>failure_matrix_test.go</code>
            </td>
          </tr>
          <tr>
            <td>A killed Worker resumes without creating a second agent session</td>
            <td>
              <TermTip
                term="test-worker-crash"
                tip="Kills the Worker after the agent is running and a heartbeat checkpoint exists, then requires the retry to resume from that checkpoint against the same session."
              >TestActivityWorkerCrashResumesFromHeartbeatWithoutSecondSession</TermTip>
              {" "}covers failure after the agent is running;{" "}
              <TermTip
                term="test-cancel-before-checkpoint-kill"
                tip="The same case from the other side: with no checkpoint recorded, the retry must resolve the running session by identity rather than start a second one."
              >TestActivityCancellationBeforeFirstCheckpointUsesResolvedSession</TermTip>
              {" "}covers failure before the first heartbeat
            </td>
          </tr>
        </tbody>
      </table>
    </section>
  </article>
</PageLayout>

<style>
  .code-index {
    padding-block-end: var(--space-3xl);
  }

  .code-index > * + * {
    margin-block-start: clamp(var(--space-l), 6vw, var(--space-2xl));
  }

  .code-index__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    padding-block: var(--space-s);
    border-block: var(--border-hairline);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .code-index__tabs a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .code-index__tabs a:hover,
  .code-index__tabs a[aria-current="page"] {
    color: var(--color-accent);
  }

  .code-index__guide {
    max-width: var(--measure);
    color: var(--color-text-secondary);
    font-size: var(--step-1);
    line-height: var(--leading-relaxed);
  }

  .code-index__guide p {
    margin: 0;
  }

  .code-index__files {
    margin: 0;
    padding: 0;
    border-top: var(--border-hairline);
    list-style: none;
  }

  .code-index__files li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(11rem, auto);
    gap: var(--space-l);
    padding-block: var(--space-l);
    align-items: start;
    border-bottom: var(--border-hairline);
  }

  .code-index__number {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .code-index__files .kicker {
    margin: 0 0 var(--space-xs);
  }

  .code-index__files h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step-0);
  }

  .code-index__files p:not(.kicker) {
    max-width: var(--measure);
    margin: var(--space-xs) 0 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .code-index__files a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    color: var(--color-text);
    font-family: var(--font-display);
    text-decoration: none;
  }

  .code-index__files a:hover {
    color: var(--color-accent);
  }

  .code-index__tests h2 {
    margin: 0 0 var(--space-s);
  }

  .code-index__tests .code-index__guide {
    margin-block-end: var(--space-l);
    font-size: var(--step-0);
  }

  /* Go test identifiers run to 73 characters with no break opportunity.
     Fixed layout binds the columns to the container instead of the content,
     and overflow-wrap lets a long identifier break rather than push. */
  .code-index__matrix {
    width: 100%;
    table-layout: fixed;
    border: var(--border-hairline);
    border-collapse: collapse;
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .code-index__matrix th:first-child,
  .code-index__matrix td:first-child {
    width: 30%;
  }

  /* Prose cells break words only as a last resort, and with a hyphen; the
     bare `anywhere` this used to share with code broke ordinary words at
     arbitrary characters on narrow phone columns. */
  .code-index__matrix th,
  .code-index__matrix td {
    padding: var(--space-xs) var(--space-s);
    border: var(--border-hairline);
    text-align: start;
    vertical-align: top;
    overflow-wrap: break-word;
    hyphens: auto;
    -webkit-hyphenate-limit-before: 4;
    -webkit-hyphenate-limit-after: 4;
    hyphenate-limit-chars: 10 4 4;
  }

  .code-index__matrix th {
    background: var(--color-bg-subtle);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }

  /* :global because the identifiers render through TermTip, whose elements
     carry that component's scope attribute, not this page's; a scoped
     `code` selector here never matches them. */
  .code-index__matrix :global(code) {
    overflow-wrap: anywhere;
    hyphens: none;
    white-space: normal;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  @media (max-width: 720px) {
    .code-index__files li {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: var(--space-s);
    }

    .code-index__files a {
      grid-column: 2;
      margin-block-start: var(--space-s);
    }

    /* Narrow columns cannot spare two space-s gutters per cell. */
    .code-index__matrix th,
    .code-index__matrix td {
      padding: var(--space-2xs) var(--space-xs);
    }
  }
</style>
