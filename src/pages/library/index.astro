---
import PageLayout from "@/layouts/PageLayout.astro";
import {
  getLibraries,
  getExplorers,
  getResourceLibraries,
  getDigestStream,
} from "@/lib/knowledge/build";
import type { Library, Explorer, ResourceLibrary, DigestItem } from "@/lib/knowledge/types";

const libraries: Library[] = getLibraries();
const explorers: Explorer[] = getExplorers();
const resourceLibraries: ResourceLibrary[] = await getResourceLibraries();
const digestItems: DigestItem[] = getDigestStream(30);

const RESOURCE_CAP = 8;
---

<PageLayout
  title="Library"
  kicker="Research"
  intro="This is where I keep the collections. Nine ADS libraries I curate on NASA ADS, three thematic literature explorers, a podcast library, essays, and a live feed of what's been added recently. It's the reading side of the research."
>
  <div class="stack stack-l">

    <!-- 1. Research libraries -->
    <section>
      <div class="sub-head">
        <h2 class="sub">Research libraries</h2>
        <a class="sub-head__more" href="https://ui.adsabs.harvard.edu" rel="noopener noreferrer">
          NASA ADS ↗
        </a>
      </div>
      <ul role="list" class="auto-grid" style="--grid-min: 18rem; --grid-gap: var(--space-m)">
        {
          libraries.map((lib: Library) => {
            const recentPapers = lib.papers.slice(0, 2);
            return (
              <li class="lib-card">
                <div class="lib-card__head">
                  <h3 class="lib-card__title">{lib.name}</h3>
                  <span class={`visibility-chip ${lib.public ? "visibility-chip--public" : "visibility-chip--private"}`}>
                    {lib.public ? "public" : "private"}
                  </span>
                </div>
                <p class="lib-card__count">{lib.numDocuments} documents</p>
                {lib.description && <p class="lib-card__desc">{lib.description}</p>}
                {recentPapers.length > 0 && (
                  <ul role="list" class="lib-card__recent">
                    {recentPapers.map((p) => (
                      <li class="lib-card__recent-title muted">{p.title}</li>
                    ))}
                  </ul>
                )}
                <p class="lib-card__cta">
                  <a href={`/library/${lib.id}`}>Browse →</a>
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- 2. Thematic explorers -->
    <section>
      <h2 class="sub">Thematic explorers</h2>
      <p class="muted measure" style="margin-block-end: var(--space-m)">
        Navigable, themed maps of recent literature. Each one starts from an ADS library and structures the papers into themes using SciX MCP.
      </p>
      <ul role="list" class="auto-grid" style="--grid-min: 18rem; --grid-gap: var(--space-m)">
        {
          explorers.map((ex: Explorer) => (
            <li class="lib-card">
              <h3 class="lib-card__title">{ex.title}</h3>
              <p class="lib-card__count">{ex.paperCount} papers · {ex.themeCount} themes</p>
              <div class="cluster" style="--cluster-gap: var(--space-2xs)">
                {ex.sections.map((s) => (
                  <span class="tag">{s.label}</span>
                ))}
              </div>
              <div class="lib-card__links">
                <a href={ex.homepage} rel="noopener noreferrer">Open explorer ↗</a>
                <a href="/learning">On the site</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 3. Resource libraries -->
    <section>
      <h2 class="sub">Resource libraries</h2>
      <div class="stack stack-l">
        {
          resourceLibraries.map((rl: ResourceLibrary) => {
            const shown = rl.items.slice(0, RESOURCE_CAP);
            const overflow = rl.items.length - shown.length;
            return (
              <div class="resource-lib">
                <div class="resource-lib__head">
                  <h3 class="resource-lib__name">{rl.name}</h3>
                  <span class="tag">{rl.kind}</span>
                </div>
                {rl.description && <p class="muted measure">{rl.description}</p>}
                <ul role="list" class="resource-list">
                  {shown.map((item) => (
                    <li class="resource-row">
                      <a href={item.url} rel="noopener noreferrer" class="resource-row__title">
                        {item.title}
                      </a>
                      {item.meta && <span class="muted resource-row__meta">{item.meta}</span>}
                    </li>
                  ))}
                </ul>
                {overflow > 0 && (
                  <p class="muted" style="font-size: var(--step--1)">+{overflow} more</p>
                )}
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- 4. What's new -->
    <section>
      <h2 class="sub">What's new</h2>
      <p class="muted measure" style="margin-block-end: var(--space-m)">
        Recent papers across all libraries, ordered by publication date. This is the recency prior from the hybrid scorer in my code-intelligence-digest app.
      </p>
      <div class="digest-table-wrap">
        <table class="digest-table">
          <thead>
            <tr>
              <th>Paper</th>
              <th class="digest-table__col-lib">Library</th>
              <th class="digest-table__col-date">Date</th>
              <th class="digest-table__col-cites">Cites</th>
            </tr>
          </thead>
          <tbody>
            {
              digestItems.map((item: DigestItem) => (
                <tr>
                  <td>
                    <a href={item.url} rel="noopener noreferrer" class="digest-title">
                      {item.title} ↗
                    </a>
                  </td>
                  <td class="digest-table__col-lib">
                    <span class="tag">{item.library}</span>
                  </td>
                  <td class="digest-table__col-date muted">
                    {item.pubdate ?? item.year ?? ""}
                  </td>
                  <td class="digest-table__col-cites muted">
                    {item.citationCount}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Cross-link -->
    <p class="crosslink muted">
      These libraries anchor the open threads.{" "}
      <a href="/threads">See the threads →</a>
    </p>

  </div>
</PageLayout>

<style>
  /* ---- section headings ---- */
  .sub {
    font-size: var(--step-2);
    margin-block-end: var(--space-2xs);
  }

  .sub-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    margin-block-end: var(--space-m);
  }

  .sub-head .sub {
    margin-block-end: 0;
  }

  .sub-head__more {
    font-size: var(--step--1);
    white-space: nowrap;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .sub-head__more:hover {
    color: var(--color-accent);
  }

  /* ---- library cards ---- */
  .lib-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border: var(--border-hairline);
    border-radius: var(--radius-l);
    background: var(--color-bg-subtle);
    transition: border-color 0.15s ease;
  }

  .lib-card:hover {
    border-color: color-mix(in oklch, var(--color-accent) 40%, var(--color-border));
  }

  .lib-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .lib-card__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .lib-card__count {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    margin: 0;
  }

  .lib-card__desc {
    font-size: var(--step-0);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-normal);
  }

  .lib-card__recent {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .lib-card__recent-title {
    font-size: var(--step--1);
    line-height: var(--leading-snug);

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lib-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
    font-size: var(--step--1);
  }

  .lib-card__links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .lib-card__links a:hover {
    color: var(--color-accent);
  }

  .lib-card__cta {
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
  }

  .lib-card__cta a {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .lib-card__cta a:hover {
    color: var(--color-accent);
  }

  /* ---- visibility chip ---- */
  .visibility-chip {
    flex-shrink: 0;
    font-size: var(--step--1);
    font-family: var(--font-mono);
    padding: 0.15em 0.55em;
    border-radius: 999px;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  .visibility-chip--public {
    background: color-mix(in oklch, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
  }

  .visibility-chip--private {
    background: color-mix(in oklch, var(--color-border) 60%, transparent);
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .visibility-chip--public {
    background: color-mix(in oklch, var(--color-accent) 18%, transparent);
  }

  /* ---- resource libraries ---- */
  .resource-lib {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .resource-lib__head {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .resource-lib__name {
    font-size: var(--step-1);
    margin: 0;
  }

  .resource-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .resource-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-xs);
    border-bottom: var(--border-hairline);
  }

  .resource-row__title {
    font-size: var(--step-0);
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .resource-row__title:hover {
    color: var(--color-accent);
  }

  .resource-row__meta {
    font-size: var(--step--1);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  /* ---- digest table ---- */
  .digest-table-wrap {
    overflow-x: auto;
    border: var(--border-hairline);
    border-radius: var(--radius);
  }

  .digest-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .digest-table th {
    text-align: left;
    padding: var(--space-xs) var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-text-secondary);
    border-bottom: var(--border-hairline);
    background: var(--color-bg-subtle);
    white-space: nowrap;
  }

  .digest-table td {
    padding: var(--space-xs) var(--space-s);
    vertical-align: middle;
    border-bottom: var(--border-hairline);
  }

  .digest-table tr:last-child td {
    border-bottom: none;
  }

  .digest-table tr:hover td {
    background: color-mix(in oklch, var(--color-surface) 60%, transparent);
  }

  .digest-title {
    color: var(--color-text);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition: color 0.12s ease;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .digest-title:hover {
    color: var(--color-accent);
  }

  .digest-table__col-lib {
    white-space: nowrap;
  }

  .digest-table__col-date {
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  .digest-table__col-cites {
    white-space: nowrap;
    font-family: var(--font-mono);
    text-align: right;
  }

  /* ---- cross-link footer ---- */
  .crosslink {
    font-size: var(--step-0);
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
  }

  .crosslink a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .crosslink a:hover {
    text-decoration: underline;
  }
</style>
