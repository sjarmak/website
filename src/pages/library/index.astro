---
import PageLayout from "@/layouts/PageLayout.astro";
import {
  getLibraries,
  getExplorers,
  getPodcasts,
  getDigestStream,
} from "@/lib/knowledge/build";
import type {
  Library,
  Explorer,
  PodcastSeries,
  PodcastEpisode,
  DigestItem,
} from "@/lib/knowledge/types";

const libraries: Library[] = getLibraries();
const explorers: Explorer[] = getExplorers();
const { series: podcastSeries, standalone: podcastStandalone } = await getPodcasts();
const digestItems: DigestItem[] = getDigestStream(30);
---

<PageLayout
  title="Library"
  kicker="Research"
  intro="This is where I keep the collections. ADS libraries I curate on NASA ADS, five thematic literature explorers, a podcast library, and a live feed of what's been added recently. It's the reading side of the research."
>
  <div class="stack stack-l">

    <!-- 1. Research libraries -->
    <section>
      <div class="sub-head">
        <h2 class="sub">Research libraries</h2>
        <a class="sub-head__more" href="https://ui.adsabs.harvard.edu" rel="noopener noreferrer">
          NASA ADS ↗
        </a>
      </div>
      <ul role="list" class="auto-grid" style="--grid-min: 18rem; --grid-gap: var(--space-m)">
        {
          libraries.map((lib: Library) => {
            const recentPapers = lib.papers.slice(0, 2);
            return (
              <li class="lib-card">
                <div class="lib-card__head">
                  <h3 class="lib-card__title">{lib.name}</h3>
                </div>
                <p class="lib-card__count">{lib.numDocuments} documents</p>
                {lib.description && <p class="lib-card__desc">{lib.description}</p>}
                {recentPapers.length > 0 && (
                  <ul role="list" class="lib-card__recent">
                    {recentPapers.map((p) => (
                      <li class="lib-card__recent-title muted">{p.title}</li>
                    ))}
                  </ul>
                )}
                <p class="lib-card__cta">
                  <a href={`/library/${lib.id}`}>Browse →</a>
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- 2. Thematic explorers -->
    <section>
      <h2 class="sub">Thematic explorers</h2>
      <p class="muted measure" style="margin-block-end: var(--space-m)">
        Navigable, themed maps of recent literature. Each one starts from an ADS library and structures the papers into themes using SciX MCP.
      </p>
      <ul role="list" class="auto-grid" style="--grid-min: 18rem; --grid-gap: var(--space-m)">
        {
          explorers.map((ex: Explorer) => (
            <li class="lib-card">
              <h3 class="lib-card__title">{ex.title}</h3>
              <p class="lib-card__count">{ex.paperCount} papers · {ex.themeCount} themes</p>
              {ex.blurb && <p class="lib-card__desc">{ex.blurb}</p>}
              <div class="cluster" style="--cluster-gap: var(--space-2xs)">
                {ex.sections.map((s) => (
                  <span class="tag">{s.label}</span>
                ))}
              </div>
              <p class="lib-card__cta">
                <a href={ex.homepage} rel="noopener noreferrer">Open explorer ↗</a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 3. Podcasts -->
    <section>
      <h2 class="sub">Podcasts</h2>
      <p class="muted measure" style="margin-block-end: var(--space-m)">
        Deep-dive episodes generated from the literature surveys. Listen inline, or download the audio.
      </p>
      <div class="stack stack-l">
        {
          podcastSeries.map((s: PodcastSeries) => (
            <div>
              <h3 class="pod-series">{s.name}</h3>
              <ul role="list" class="stack">
                {s.episodes.map((ep: PodcastEpisode) => (
                  <li class="pod-ep">
                    <span class="pod-ep__title">
                      {ep.episode ? `${ep.episode}. ` : ""}
                      {ep.title}
                    </span>
                    <p class="muted">{ep.description}</p>
                    {ep.embedUrl ? (
                      <iframe class="pod-ep__embed" src={ep.embedUrl} loading="lazy" title={ep.title} />
                    ) : (
                      ep.audioUrl && (
                        <audio controls preload="none">
                          <source src={ep.audioUrl} type="audio/mpeg" />
                        </audio>
                      )
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        {
          podcastStandalone.map((ep: PodcastEpisode) => (
            <div class="pod-ep">
              <span class="pod-ep__title">{ep.title}</span>
              <p class="muted">{ep.description}</p>
              {ep.embedUrl ? (
                <iframe class="pod-ep__embed" src={ep.embedUrl} loading="lazy" title={ep.title} />
              ) : (
                ep.audioUrl && (
                  <audio controls preload="none">
                    <source src={ep.audioUrl} type="audio/mpeg" />
                  </audio>
                )
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- 4. What's new -->
    <section>
      <h2 class="sub">What's new</h2>
      <p class="muted measure" style="margin-block-end: var(--space-m)">
        Recent papers across all libraries, ordered by publication date. This is the recency prior from the hybrid scorer in my code-intelligence-digest app.
      </p>
      <div class="digest-table-wrap">
        <table class="digest-table">
          <thead>
            <tr>
              <th>Paper</th>
              <th class="digest-table__col-lib">Library</th>
              <th class="digest-table__col-date">Date</th>
              <th class="digest-table__col-cites">Cites</th>
            </tr>
          </thead>
          <tbody>
            {
              digestItems.map((item: DigestItem) => (
                <tr>
                  <td>
                    <a href={item.url} rel="noopener noreferrer" class="digest-title">
                      {item.title}
                    </a>
                  </td>
                  <td class="digest-table__col-lib">
                    <span class="tag">{item.library}</span>
                  </td>
                  <td class="digest-table__col-date muted">
                    {item.pubdate ?? item.year ?? ""}
                  </td>
                  <td class="digest-table__col-cites muted">
                    {item.citationCount}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Cross-link -->
    <p class="crosslink muted">
      These libraries anchor the open threads.{" "}
      <a href="/threads">See the threads →</a>
    </p>

  </div>
</PageLayout>

<style>
  /* ---- section headings ---- */
  .sub {
    font-size: var(--step-2);
    margin-block-end: var(--space-2xs);
  }

  .sub-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    margin-block-end: var(--space-m);
  }

  .sub-head .sub {
    margin-block-end: 0;
  }

  .sub-head__more {
    font-size: var(--step--1);
    white-space: nowrap;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .sub-head__more:hover {
    color: var(--color-accent);
  }

  /* ---- library cards ---- */
  .lib-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border: var(--border-hairline);
    border-radius: var(--radius-l);
    background: var(--color-bg-subtle);
    transition: border-color 0.15s ease;
  }

  .lib-card:hover {
    border-color: color-mix(in oklch, var(--color-accent) 40%, var(--color-border));
  }

  .lib-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .lib-card__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .lib-card__count {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    margin: 0;
  }

  .lib-card__desc {
    font-size: var(--step-0);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-normal);
  }

  .lib-card__recent {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .lib-card__recent-title {
    font-size: var(--step--1);
    line-height: var(--leading-snug);

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lib-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
    font-size: var(--step--1);
  }

  .lib-card__links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .lib-card__links a:hover {
    color: var(--color-accent);
  }

  .lib-card__cta {
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
  }

  .lib-card__cta a {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .lib-card__cta a:hover {
    color: var(--color-accent);
  }

  /* ---- podcasts ---- */
  .pod-series {
    font-size: var(--step-1);
    margin-block-end: var(--space-s);
  }

  .pod-ep {
    padding-block: var(--space-s);
    border-bottom: var(--border-hairline);
  }

  .pod-ep__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .pod-ep__embed {
    width: 100%;
    height: 152px;
    border: 0;
    border-radius: var(--radius);
    margin-block-start: var(--space-s);
  }

  .pod-ep audio {
    width: 100%;
    margin-block-start: var(--space-s);
  }

  /* ---- digest table ---- */
  .digest-table-wrap {
    overflow-x: auto;
    border: var(--border-hairline);
    border-radius: var(--radius);
  }

  .digest-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .digest-table th {
    text-align: left;
    padding: var(--space-xs) var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-text-secondary);
    border-bottom: var(--border-hairline);
    background: var(--color-bg-subtle);
    white-space: nowrap;
  }

  .digest-table td {
    padding: var(--space-xs) var(--space-s);
    vertical-align: middle;
    border-bottom: var(--border-hairline);
  }

  .digest-table tr:last-child td {
    border-bottom: none;
  }

  .digest-table tr:hover td {
    background: color-mix(in oklch, var(--color-surface) 60%, transparent);
  }

  .digest-title {
    color: var(--color-text);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition: color 0.12s ease;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .digest-title:hover {
    color: var(--color-accent);
  }

  .digest-table__col-lib {
    white-space: nowrap;
  }

  .digest-table__col-date {
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  .digest-table__col-cites {
    white-space: nowrap;
    font-family: var(--font-mono);
    text-align: right;
  }

  /* ---- cross-link footer ---- */
  .crosslink {
    font-size: var(--step-0);
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
  }

  .crosslink a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .crosslink a:hover {
    text-decoration: underline;
  }
</style>
