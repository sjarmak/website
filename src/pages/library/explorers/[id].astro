---
import PageLayout from "@/layouts/PageLayout.astro";
import {
  getExplorers,
  explorerPaperUrl,
  explorerReadingPath,
  explorerOpportunities,
} from "@/lib/knowledge/build";
import type { Explorer, ExplorerPaper, ExplorerSection } from "@/lib/knowledge/types";

export function getStaticPaths() {
  return getExplorers().map((ex: Explorer) => ({
    params: { id: ex.id },
    props: { explorer: ex },
  }));
}

const { explorer } = Astro.props as { explorer: Explorer };

// Group papers under the themes they belong to (a paper can appear in several).
const papersByKey = new Map<string, ExplorerPaper[]>();
for (const s of explorer.sections) papersByKey.set(s.key, []);
for (const p of explorer.papers) {
  for (const b of p.branches ?? []) {
    if (papersByKey.has(b)) papersByKey.get(b)!.push(p);
  }
}

const reading = explorerReadingPath(explorer);
const opportunities = explorerOpportunities(explorer);
const showFilter = explorer.sections.length > 1;
const showSearch = explorer.papers.length > 6;
const resultNoun = explorer.id === "thirty-papers" ? "readings" : "papers";
const noteLabel = explorer.id === "thirty-papers" ? "Why read it" : "Synthesis";
const readingIntro =
  explorer.id === "thirty-papers"
    ? "Follow the collection in order. The route moves from practical intuition through architecture and scale, then closes on compression, complexity, and intelligence."
    : "Start here and read in order; the path moves from foundations toward the open edge.";

function authorYear(p: ExplorerPaper): string {
  return [p.firstAuthor, p.year].filter(Boolean).join(" · ");
}

function paperId(p: ExplorerPaper): string {
  return p.bibcode ?? p.arxiv ?? p.url ?? p.title;
}

function paperSearchText(p: ExplorerPaper, section: ExplorerSection): string {
  const notes = (p.notes ?? []).flatMap((note) => [note.takeaway, note.why]);
  return [p.title, p.firstAuthor, p.year, section.label, ...notes]
    .filter(Boolean)
    .join(" ")
    .toLocaleLowerCase();
}
---

<PageLayout
  title={explorer.title}
  kicker="Thematic explorer"
  intro={explorer.blurb}
  description={explorer.metaDescription}
>
  <div class="stack stack-l">
    <div class="ex-head">
      <p class="ex-count">
        <span class="ex-count__num">{explorer.paperCount}</span> papers
        <span class="ex-count__sep">·</span>
        <span class="ex-count__num">{explorer.themeCount}</span> themes
      </p>
      <a href="/library" class="back-link">← All collections</a>
    </div>

    {
      explorer.source && (
        <aside class="source-note" data-source-credit>
          <div>
            <p class="source-note__label">Source collection</p>
            <p class="source-note__copy measure">{explorer.source.note}</p>
          </div>
          <a
            class="source-note__link"
            href={explorer.source.url}
            rel="noopener noreferrer"
          >
            Open 30papers.com ↗
          </a>
        </aside>
      )
    }

    {
      (showSearch || showFilter) && (
        <div class="explorer-tools">
          {showSearch && (
            <div class="paper-search">
              <label class="visually-hidden" for="paper-search">
                Search this explorer
              </label>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="8.5" cy="8.5" r="5.75"></circle>
                <path d="m13 13 4 4"></path>
              </svg>
              <input
                id="paper-search"
                type="search"
                placeholder="Search titles, authors, or ideas"
                autocomplete="off"
                aria-controls="themes"
                data-paper-search
              />
            </div>
          )}
          <p
            class="result-count"
            aria-live="polite"
            data-result-count
            data-result-noun={resultNoun}
          >
            {explorer.paperCount} {resultNoun} shown
          </p>
          {showFilter && (
            <nav
              class="theme-filter cluster"
              aria-label="Filter by theme"
              data-theme-filter
              style="--cluster-gap: var(--space-2xs)"
            >
              <button
                class="filter-btn filter-btn--active"
                data-key="all"
                aria-controls="themes"
                aria-pressed="true"
              >
                All themes
              </button>
              {explorer.sections.map((s: ExplorerSection) => (
                <button
                  class="filter-btn"
                  data-key={s.key}
                  aria-controls="themes"
                  aria-pressed="false"
                >
                  {s.label}
                  <span aria-hidden="true">{s.count}</span>
                </button>
              ))}
            </nav>
          )}
        </div>
      )
    }

    <div id="themes" class="stack stack-l">
      {
        explorer.sections.map((s: ExplorerSection) => {
          const papers = papersByKey.get(s.key) ?? [];
          // Every authored note list a section can carry. Omitting one here
          // silently drops committed content from the page: `questions` was
          // absent until 2026-08-18, which hid all 33 of memory-design's.
          const notes = [
            { label: "Key threads", items: s.themes ?? [] },
            { label: "Open gaps", items: s.gaps ?? [] },
            { label: "Open questions", items: s.questions ?? [] },
          ].filter((n) => n.items.length > 0);
          return (
            <section class="theme" data-key={s.key} id={`theme-${s.key}`}>
              <h2 class="theme__label">{s.label}</h2>
              {s.summary &&
                s.summary
                  .split(/\n{2,}/)
                  .map((para: string) => <p class="theme__summary measure">{para}</p>)}

              {notes.length > 0 && (
                <div class="theme__notes">
                  {notes.map((n) => (
                    <details class="note">
                      <summary class="note__toggle">{n.label}</summary>
                      <ul role="list" class="note__list">
                        {n.items.map((item) => (
                          <li class="measure">{item}</li>
                        ))}
                      </ul>
                    </details>
                  ))}
                </div>
              )}

              {papers.length > 0 && (
                <ol role="list" class="paper-list">
                  {papers.map((p) => {
                    const note = (p.notes ?? []).find((n) => n.branch === s.key) ?? (p.notes ?? [])[0];
                    const synth = p.synthesis;
                    const synthParts = synth
                      ? ([
                          ["Plain-language abstract", synth.plainAbstract],
                          ["Motivation", synth.motivation],
                          ["Methodology", synth.methodology],
                          ["Results", synth.results],
                        ] as const).filter(([, body]) => body?.trim())
                      : [];
                    return (
                      <li
                        class="paper"
                        data-paper-row
                        data-paper-id={paperId(p)}
                        data-search={paperSearchText(p, s)}
                      >
                        <a href={explorerPaperUrl(p)} rel="noopener noreferrer" class="paper__title">
                          {p.title}
                        </a>
                        <p class="paper__meta muted">
                          {authorYear(p)}
                          {typeof p.citationCount === "number" && (
                            <>
                              <span aria-hidden="true">·</span>
                              <span>{p.citationCount} cites</span>
                            </>
                          )}
                          {p.arxiv && <span class="tag">arXiv</span>}
                        </p>
                        {synthParts.length > 0 ? (
                          <details class="paper__note">
                            <summary class="paper__note-toggle">{noteLabel}</summary>
                            <div class="paper__note-body">
                              {synthParts.map(([label, body]) => (
                                <p class="paper__note-text measure">
                                  <span class="paper__note-label">{label}</span>
                                  {body}
                                </p>
                              ))}
                            </div>
                          </details>
                        ) : (
                          note &&
                          (note.takeaway || note.why) && (
                            <details class="paper__note">
                              <summary class="paper__note-toggle">{noteLabel}</summary>
                              <div class="paper__note-body">
                                {note.takeaway && <p class="paper__note-text measure">{note.takeaway}</p>}
                                {note.why && (
                                  <p class="paper__note-text paper__note-why measure muted">
                                    <span class="paper__note-label">Why it matters</span>
                                    {note.why}
                                  </p>
                                )}
                              </div>
                            </details>
                          )
                        )}
                      </li>
                    );
                  })}
                </ol>
              )}
            </section>
          );
        })
      }
    </div>

    <p class="empty-state" hidden data-empty-state>
      No {resultNoun} match this search and theme.
    </p>

    {
      reading.length > 0 && (
        <section class="block">
          <h2 class="section-head">A reading path</h2>
          <p class="muted measure" style="margin-block-end: var(--space-m)">
            {readingIntro}
          </p>
          <div class="stack stack-m">
            {reading.map((grp) => (
              <div class="reading-group">
                {grp.group && <h3 class="reading-group__label">{grp.group}</h3>}
                <ol role="list" class="reading-stops">
                  {grp.stops.map((st) => (
                    <li class="reading-stop">
                      <span class="reading-stop__n" aria-hidden="true">
                        {String(st.n).padStart(2, "0")}
                      </span>
                      <a href={st.url} rel="noopener noreferrer" class="reading-stop__title">
                        {st.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      opportunities.length > 0 && (
        <section class="block">
          <h2 class="section-head">Open problems</h2>
          <p class="muted measure" style="margin-block-end: var(--space-m)">
            Where the literature is thin and the next contribution could land.
          </p>
          <ol role="list" class="opp-list">
            {opportunities.map((o) => (
              <li class="opp">
                <h3 class="opp__title">{o.title}</h3>
                {o.description && <p class="opp__desc measure muted">{o.description}</p>}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <p class="back-footer"><a href="/library">← All collections</a></p>
  </div>
</PageLayout>

<script>
  const filter = document.querySelector<HTMLElement>("[data-theme-filter]");
  const search = document.querySelector<HTMLInputElement>("[data-paper-search]");
  const themes = [...document.querySelectorAll<HTMLElement>("#themes .theme")];
  const resultCount = document.querySelector<HTMLElement>("[data-result-count]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  let activeTheme = "all";

  function updateExplorer() {
    const query = search?.value.trim().toLocaleLowerCase() ?? "";
    const visibleIds = new Set<string>();

    for (const theme of themes) {
      const themeMatches = activeTheme === "all" || theme.dataset.key === activeTheme;
      let visibleRows = 0;

      for (const row of theme.querySelectorAll<HTMLElement>("[data-paper-row]")) {
        const searchMatches = !query || row.dataset.search?.includes(query);
        const visible = themeMatches && Boolean(searchMatches);
        row.hidden = !visible;
        if (visible) {
          visibleRows += 1;
          if (row.dataset.paperId) visibleIds.add(row.dataset.paperId);
        }
      }

      theme.hidden = !themeMatches || visibleRows === 0;
    }

    if (resultCount) {
      const noun = resultCount.dataset.resultNoun ?? "papers";
      resultCount.textContent = `${visibleIds.size} ${noun} shown`;
    }
    if (emptyState) emptyState.hidden = visibleIds.size > 0;
  }

  filter?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".filter-btn");
    if (!button?.dataset.key) return;
    activeTheme = button.dataset.key;
    for (const candidate of filter.querySelectorAll<HTMLButtonElement>(".filter-btn")) {
      const active = candidate === button;
      candidate.classList.toggle("filter-btn--active", active);
      candidate.setAttribute("aria-pressed", String(active));
    }
    updateExplorer();
  });

  search?.addEventListener("input", updateExplorer);
</script>

<style>
  .ex-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-m);
  }

  .ex-count {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    margin: 0;
  }

  .ex-count__num {
    font-size: var(--step-0);
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .ex-count__sep {
    opacity: 0.5;
  }

  .back-link {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* ---- source provenance ---- */
  .source-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-s) var(--space-l);
    align-items: end;
    padding-block: var(--space-m);
    border-block: var(--border-hairline);
  }

  .source-note__label {
    margin: 0 0 var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent);
  }

  .source-note__copy {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .source-note__link {
    font-size: var(--step--1);
    white-space: nowrap;
    text-decoration: none;
  }

  /* ---- search and theme filter ---- */
  .explorer-tools {
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) auto;
    gap: var(--space-s) var(--space-m);
    align-items: center;
    padding-block: var(--space-s);
    border-block: var(--border-hairline);
  }

  .paper-search {
    position: relative;
    width: min(100%, 34rem);
  }

  .paper-search svg {
    position: absolute;
    inset-inline-start: var(--space-xs);
    inset-block-start: 50%;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .paper-search input {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-2xs) var(--space-xs) var(--space-2xs) 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-subtle);
    color: var(--color-text);
    font: inherit;
  }

  .paper-search input::placeholder {
    color: var(--color-text-muted);
  }

  .result-count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .theme-filter {
    grid-column: 1 / -1;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    min-height: 2.75rem;
    padding: 0.45em 0.8em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter-btn--active {
    background: color-mix(in oklch, var(--color-accent) 14%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  [data-theme="dark"] .filter-btn--active {
    background: color-mix(in oklch, var(--color-accent) 18%, transparent);
  }

  .filter-btn span {
    margin-inline-start: 0.4em;
    color: var(--color-text-muted);
  }

  /* ---- theme sections ---- */
  .theme {
    scroll-margin-top: var(--space-l);
  }

  .theme__label {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    margin-block-end: var(--space-xs);
  }

  .theme__summary {
    font-size: var(--step-0);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-s);
  }

  .theme__notes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    margin-block-end: var(--space-s);
  }

  .note {
    font-size: var(--step--1);
  }

  .note__toggle {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    transition: color 0.12s ease;
  }

  .note__toggle::-webkit-details-marker {
    display: none;
  }

  .note__toggle::before {
    content: "+ ";
  }

  details[open] .note__toggle::before {
    content: "− ";
  }

  .note__toggle:hover {
    color: var(--color-accent);
  }

  .note__list {
    margin-block-start: var(--space-xs);
    padding-inline-start: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .note__list li {
    list-style: disc;
  }

  /* ---- paper list (shared visual language with /library/[id]) ---- */
  .paper-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    padding: 0;
  }

  .paper {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-block: var(--space-s);
    border-bottom: var(--border-hairline);
  }

  .paper[hidden],
  .theme[hidden] {
    display: none;
  }

  .paper:first-child {
    border-top: var(--border-hairline);
  }

  .paper__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .paper__title:hover {
    color: var(--color-accent);
  }

  .paper__meta {
    font-size: var(--step--1);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  /* ---- per-paper synthesis disclosure ---- */
  .paper__note {
    margin-block-start: var(--space-3xs);
  }

  .paper__note-toggle {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    transition: color 0.12s ease;
  }

  .paper__note-toggle::-webkit-details-marker {
    display: none;
  }

  .paper__note-toggle::before {
    content: "+ ";
  }

  details[open] .paper__note-toggle::before {
    content: "− ";
  }

  .paper__note-toggle:hover {
    color: var(--color-accent);
  }

  .paper__note-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
  }

  .paper__note-text {
    font-size: var(--step-0);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .paper__note-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-block-end: var(--space-3xs);
  }

  .empty-state {
    margin: 0;
    padding: var(--space-l);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-secondary);
    text-align: center;
  }

  /* ---- standalone blocks (reading path, open problems) ---- */
  .block {
    padding-block-start: var(--space-l);
    border-top: var(--border-hairline);
  }

  .section-head {
    font-size: var(--step-2);
    margin-block-end: var(--space-2xs);
  }

  .reading-group__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-block-end: var(--space-2xs);
  }

  .reading-stops {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .reading-stop {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
    padding-block: var(--space-2xs);
  }

  .reading-stop__n {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent);
    flex-shrink: 0;
    width: 2ch;
  }

  .reading-stop__title {
    color: var(--color-text);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition: color 0.12s ease;
  }

  .reading-stop__title:hover {
    color: var(--color-accent);
  }

  /* ---- open problems ---- */
  .opp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: opp;
    display: flex;
    flex-direction: column;
  }

  .opp {
    counter-increment: opp;
    padding-block: var(--space-m);
    border-bottom: var(--border-hairline);
  }

  .opp:first-child {
    border-top: var(--border-hairline);
  }

  .opp__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-3xs);
  }

  .opp__title::before {
    content: counter(opp, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent);
    margin-inline-end: var(--space-xs);
  }

  .opp__desc {
    font-size: var(--step-0);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* ---- footer ---- */
  .back-footer {
    padding-block-start: var(--space-m);
    font-size: var(--step-0);
  }

  .back-footer a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .back-footer a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 42rem) {
    .source-note {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .source-note__link {
      white-space: normal;
    }

    .explorer-tools {
      grid-template-columns: 1fr;
    }

    .result-count {
      grid-row: 2;
    }

    .theme-filter {
      grid-column: 1;
    }
  }
</style>
