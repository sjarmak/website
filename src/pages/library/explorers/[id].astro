---
import ThematicExplorer from "@/components/knowledge/ThematicExplorer.astro";
import { getExplorers } from "@/lib/knowledge/build";
import type { Explorer } from "@/lib/knowledge/types";

export function getStaticPaths() {
  return getExplorers().map((explorer: Explorer) => ({
    params: { id: explorer.id }, props: { explorer },
  }));
}
const { explorer } = Astro.props as { explorer: Explorer };
---
<ThematicExplorer explorer={explorer} />
