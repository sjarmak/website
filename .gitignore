# build output
dist/
# generated types
.astro/
# dependencies
node_modules/
# logs
*-debug.log*
# environment
.env
.env.production
.env.*.local
# local QA artifacts (screenshots, scratch)
.qa/

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Agent / tooling dot folders (local-only; solo repo)
.beads/
.claude/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Large local source video (the compressed web copy lives in public/media/)
/JarmakSciXDemo.mp4

# Brainstorm session working dir (local-only)
.brainstorm/

# local MCP config (machine-specific, not for the public repo)
.mcp.json

# transient SciX synthesis shards (merged into paper-synthesis.json)
.synth-shards/

# local digest pipeline run logs + handoff JSON (machine-local, transient)
.digest-runs/

# knowledge-sync run artifacts: candidates, library proposals, reports, logs
# (transient — explorer edits + libraries.json are the committed outputs)
.knowledge-sync/

# python bytecode from the knowledge build scripts
scripts/knowledge/__pycache__/

# register-stability test fixture (tests/register-stability.test.mjs): a
# far-future digest entry written transiently during the double-build test.
# Ignored so concurrent tests asserting a clean tree never see it and a
# crashed run can never commit it.
src/content/digest/daily-2098-*.md

# isolated outDirs from the stability build wrapper
dist-stability-*/
