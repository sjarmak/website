#!/usr/bin/env python3
from __future__ import annotations

import os
from pathlib import Path


project_root = Path(__file__).resolve().parents[3]
os.execvp(
    "uv",
    (
        "uv",
        "run",
        "--project",
        str(project_root),
        "durable-research",
        *os.sys.argv[1:],
    ),
)
