// Element kinds, tags, and custom colors for the `website` (sjarmak.ai)
// architecture model.
//
// Tags encode delivery state so prototype / evolving work renders distinctly
// from what is shipped and live on the production site:
//   #built     — live in production, exercised on every build
//   #evolving  — shipped, but the contract / surface is still moving
//   #planned   — designed, not yet implemented
//   #research  — speculative / opt-in prototype (under /prototypes, not in the nav)

specification {

  element actor {
    style {
      shape person
      color secondary
    }
  }

  element externalSystem {
    style {
      shape rectangle
      color slate
    }
  }

  element system

  element container {
    style {
      shape rectangle
    }
  }

  element component

  element datastore {
    style {
      shape cylinder
    }
  }

  // Deployment model — where each piece runs at build/serve time.
  deploymentNode host {
    style {
      shape rectangle
      color slate
    }
  }
  deploymentNode proc

  tag built {
    color #16a34a
  }
  tag evolving {
    color #d97706
  }
  tag planned {
    color #64748b
  }
  tag research {
    color #6366f1
  }

  // Cross-cutting: carried by any element that is a known risk / open question
  // for a design review (in addition to its delivery-state tag).
  tag risk {
    color #dc2626
  }
}
